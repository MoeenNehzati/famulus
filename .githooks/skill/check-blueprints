#!/usr/bin/env bash
# Repository-validation owner for the live v6 module/source graph, tracked
# blueprint files, ownership paths, and generated contract synchronization.
# Certification remains a separate gate and is not duplicated here.
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
python3 "$repo_root/repo_checks.py" --suite validators --repository-view staged --validator skill-maker/blueprints
