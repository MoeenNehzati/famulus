#!/usr/bin/env bash
# Repository-validation owner for the live v5 module/source graph, tracked
# blueprint files, ownership paths, and generated contract synchronization.
# Certification and migration remain separate gates and are not duplicated here.
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
python3 "$repo_root/repo_checks.py" --suite validators --repository-view staged --validator skill-maker/blueprints
