_famulus_checkout=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
_famulus_env="$_famulus_checkout/.famulus/bin/famulus-env"
if [[ ! -x "$_famulus_env" ]]; then
    echo "direnv: Famulus development runtime is not installed" >&2
    unset _famulus_checkout _famulus_env
    return 2
fi
_famulus_exports=$("$_famulus_env" export --shell bash) || {
    _famulus_status=$?
    unset _famulus_checkout _famulus_env _famulus_exports
    return "$_famulus_status"
}
eval "$_famulus_exports"
unset _famulus_checkout _famulus_env _famulus_exports _famulus_status
