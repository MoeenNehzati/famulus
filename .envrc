_famulus_checkout=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
_famulus_runtime="$_famulus_checkout/skills/dev-activation/_rtx/_development_activation.py"
_famulus_exports=$(python "$_famulus_runtime" export --checkout "$_famulus_checkout" --shell bash) || {
    _famulus_status=$?
    unset _famulus_checkout _famulus_runtime _famulus_exports
    return "$_famulus_status"
}
eval "$_famulus_exports"
unset _famulus_checkout _famulus_runtime _famulus_exports _famulus_status
