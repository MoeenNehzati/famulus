        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/llmhooks/inject_dispatcher_context.py", "--claude"],
            "async": false
          }
        ]
      }
    ]
  }
}
