{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://officina/references/standards-schema/docstring_format.schema.json",
  "title": "Docstring Format Schema",
  "description": "JSON Schema for the declarative docstring policy used by officina common docstring components.",
  "type": "object",
  "additionalProperties": true,
  "required": ["docstring_format_version", "name", "callable"],
  "examples": [
    {
      "docstring_format_version": 31,
      "name": "docstring_format",
      "strict": true,
      "callable": {
        "required_summary": true,
        "required_sections": [
          "Intent",
          "Rationale",
          "Pseudocode",
          "Wraps"
        ],
        "summary_min_chars": 20,
        "summary_max_chars": 240,
        "rationale_min_chars": 45,
        "rationale_max_chars": 1200,
        "optional_sections": [
          "Graph",
          "Role",
          "Phase",
          "NonInferableCalls",
          "Wraps",
          "Owns",
          "Parameters",
          "Returns",
          "Raises",
          "Attributes",
          "Pseudocode",
          "Resources",
          "Dataflow",
          "CallsFromRepo",
          "InstantiationsFromRepo",
          "Dispatches"
        ],
        "forbidden_summary_phrases": [
          "what does this do",
          "todo",
          "tbd",
          "placeholder",
          "implement me",
          "to be implemented",
          "documents the certifier control point",
          "repo-visible dependencies",
          "performs or represents the certification operation described by its inputs and outputs",
          "operation described by its inputs and outputs",
          "data carried between certification stages",
          "handles certification data or control flow for this module"
        ],
        "forbidden_intent_phrases": [
          "dependency declarations that the docstring graph can parse",
          "docstring graph can parse",
          "static dependency validation",
          "compact docstrings whose declared calls and constructors stay aligned",
          "operation described by its inputs and outputs",
          "data carried between certification stages",
          "boundary keeps its certification responsibility separate from adjacent repository steps"
        ],
        "min_pseudocode_steps": 1,
        "forbidden_rationale_phrases": [
          "this callable exists to implement the behavior described in its contract documentation",
          "this callable exists to implement the behavior described in the contract documentation",
          "implemented as described in the contract documentation",
          "implemented as described in contract documentation",
          "callable semantics explicit and auditable",
          "dependency declarations that the docstring graph can parse",
          "docstring graph can parse",
          "static dependency validation",
          "compact docstrings whose declared calls and constructors stay aligned",
          "operation described by its inputs and outputs",
          "combines repository evidence and helper results to produce or validate certification state",
          "keeps repository evidence checks separate from payload assembly and signing"
        ],
        "forbidden_pseudocode_phrases": [
          "execute the implementation steps described in source code",
          "implementation steps described in source code",
          "same as source code",
          "return result",
          "immutable_record = constructor_fields",
          "value = @",
          "out = @",
          "(args)",
          "(state)"
        ],
        "dependency_reference_sections": [
        ],
        "pseudocode": {
          "section": "Pseudocode",
          "min_steps": 1,
          "max_steps": 16,
          "max_step_chars": 140,
          "max_total_chars": 640
        },
        "module_dependencies": {
          "calls_section": "CallsFromRepo",
          "instantiates_section": "InstantiationsFromRepo",
          "dispatches_section": "Dispatches",
          "allow_implicit": true,
          "require_why": true,
          "dependency_why": {
            "misc_min_chars": 80,
            "actions": [
              "reads",
              "writes",
              "transforms",
              "validates",
              "constructs",
              "dispatches",
              "serializes",
              "parses",
              "computes",
              "orchestrates",
              "raises",
              "misc"
            ]
          },
          "pseudocode_quality": {
            "forbidden_variables": ["value", "out", "state", "args", "data"],
            "require_assigned_dependency_output_use": false
          },
          "repeated_template_detection": {
            "enabled": false,
            "min_repetitions": 3,
            "min_normalized_chars": 40
          },
          "validate_declared_calls": true,
          "validate_declared_instantiations": true,
          "validate_declared_dispatches": true,
            "report_unlisted_calls": true,
            "report_unlisted_instantiations": true,
            "ignore_non_external": true,
            "validate_dependency_targets_resolved": true,
            "enforce_declared_dependency_pseudocode_coverage": false,
            "enforce_observed_dependency_pseudocode_coverage": false,
            "forbidden_why_phrases": [
              "observed call dependency",
              "observed constructor dependency",
              "observed dependency",
              "docstring graph can parse",
              "repo-visible dependencies",
              "static dependency validation",
              "provides the named helper operation needed by function",
              "supplies the dependency result used by function",
              "to complete its certification step",
              "creates the value or error object required by function",
              "creates the value or error object required by method",
              "creates the typed object needed to carry this operation's structured result or failure",
              "checks the relevant certification invariant before the next phase proceeds"
            ]
          },
        "ownership": {
          "section": "Owns",
          "section_required": false,
          "allows_multiple": false,
          "single_owner_per_callable": true,
          "owner_resolution": "module:Ownable",
          "cross_file": {
            "enabled": true
          }
        }
      },
      "pipeline": {
        "required": false,
        "required_sections": [
          "Phases",
          "PhaseMembers"
        ],
        "optional_sections": [
          "PhaseEdges",
          "NonInferableCalls",
          "Description"
        ]
      },
      "module": {
        "required": false,
        "required_summary": true,
        "required_sections": [
          "Includes"
        ],
        "optional_sections": [
          "Workflow",
          "Traces",
          "Description",
          "Ownable"
        ],
        "ownership_registry": {
          "section": "Ownable",
          "allows_multiple": true
        }
      },
      "check_categories": {
        "formatting": [
          "docstring.formatting",
          "docstring.empty",
          "docstring.invalid-owns",
          "docstring.owns-too-many",
          "docstring.invalid-edge",
          "docstring.invalid-section",
          "docstring.duplicate-section",
          "docstring.invalid-wraps",
          "docstring.invalid-module-dependency",
          "docstring.invalid-resource",
          "docstring.invalid-dataflow",
          "docstring.absolute-dependency-not-allowed",
          "docstring.dependency-why-forbidden",
          "docstring.dependency-why-action",
          "docstring.repeated-template",
          "docstring.invalid-pseudocode",
          "docstring.pseudocode-control-empty",
          "docstring.pseudocode-else-unmatched",
          "docstring.pseudocode-loop-control-outside-loop",
          "docstring.pseudocode-ref-unresolved",
          "docstring.pseudocode-ref-ambiguous",
          "docstring.pseudocode-resource-unresolved",
          "docstring.pseudocode-placeholder-variable",
          "docstring.pseudocode-placeholder-argument",
          "docstring.pseudocode-output-unused",
          "docstring.pseudocode-step-min",
          "docstring.pseudocode-step-length",
          "docstring.pseudocode-step-cap",
          "docstring.pseudocode-total-length",
          "docstring.section-missing",
          "docstring.summary-missing",
          "docstring.summary-forbidden",
          "docstring.intent-forbidden",
          "docstring.summary-length",
          "docstring.rationale-forbidden",
          "docstring.rationale-length",
          "docstring.pseudocode-forbidden",
          "docstring.missing-graphpipeline"
        ],
        "behavioral": [
          "docstring.invalid-wraps",
          "docstring.missing",
          "docstring.module-missing",
          "docstring.unknown-owner",
          "docstring.crossfile-owner-disabled",
          "docstring.module-dependency-not-observed",
          "docstring.module-dependency-undocumented",
          "docstring.module-dependency-unresolved",
          "docstring.absolute-dependency-not-allowed",
          "docstring.dependency-why-forbidden",
          "docstring.dispatch-not-observed",
          "docstring.dispatch-undocumented",
          "docstring.dispatch-unresolved",
          "docstring.wraps-incomplete",
          "docstring.wraps-unresolved-target",
          "docstring.owning-single",
          "docstring.pseudocode-dependency-missing",
          "docstring.pseudocode-dependency-undocumented"
        ]
      }
    }
  ],
  "properties": {
    "docstring_format_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Current policy version for this docstring format contract.",
      "examples": [31]
    },
    "name": {
      "type": "string",
      "description": "Stable contract identifier used by diagnostics and tooling.",
      "examples": ["docstring_format"]
    },
    "strict": {
      "type": "boolean",
      "description": "When true, required-section checks are enforced and reported as warnings."
    },
    "callable": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required_summary": {
          "type": "boolean"
        },
        "summary_min_chars": {
          "type": "integer",
          "minimum": 0
        },
        "summary_max_chars": {
          "type": "integer",
          "minimum": 0
        },
        "rationale_min_chars": {
          "type": "integer",
          "minimum": 0
        },
        "rationale_max_chars": {
          "type": "integer",
          "minimum": 0
        },
        "required_sections": {
          "type": "array",
          "items": {"type": "string"}
        },
        "optional_sections": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_summary_phrases": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_intent_phrases": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_rationale_phrases": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_pseudocode_phrases": {
          "type": "array",
          "items": {"type": "string"}
        },
        "min_pseudocode_steps": {
          "type": "integer",
          "minimum": 0
        },
        "dependency_reference_sections": {
          "type": "array",
          "items": {"type": "string"}
        },
        "pseudocode": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "section": {"type": "string"},
            "min_steps": {"type": "integer", "minimum": 0},
            "max_steps": {"type": "integer", "minimum": 0},
            "max_step_chars": {"type": "integer", "minimum": 0},
            "max_total_chars": {"type": "integer", "minimum": 0}
          }
        },
        "module_dependencies": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "calls_section": {"type": "string"},
            "instantiates_section": {"type": "string"},
            "dispatches_section": {"type": "string"},
            "allow_implicit": {"type": "boolean"},
            "require_why": {"type": "boolean"},
            "validate_declared_calls": {"type": "boolean"},
            "validate_declared_instantiations": {"type": "boolean"},
            "validate_declared_dispatches": {"type": "boolean"},
            "report_unlisted_calls": {"type": "boolean"},
            "report_unlisted_instantiations": {"type": "boolean"},
            "ignore_non_external": {"type": "boolean"},
            "validate_dependency_targets_resolved": {"type": "boolean"},
            "enforce_declared_dependency_pseudocode_coverage": {"type": "boolean"},
            "enforce_observed_dependency_pseudocode_coverage": {"type": "boolean"},
            "dependency_why": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "actions": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "misc_min_chars": {"type": "integer", "minimum": 0}
              }
            },
            "pseudocode_quality": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "forbidden_variables": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "require_assigned_dependency_output_use": {"type": "boolean"}
              }
            },
            "repeated_template_detection": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {"type": "boolean"},
                "min_repetitions": {"type": "integer", "minimum": 0},
                "min_normalized_chars": {"type": "integer", "minimum": 0}
              }
            },
            "forbidden_why_phrases": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        },
        "ownership": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "section": {"type": "string"},
            "section_required": {"type": "boolean"},
            "allows_multiple": {"type": "boolean"},
            "single_owner_per_callable": {"type": "boolean"},
            "owner_resolution": {"type": "string"},
            "cross_file": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required": {"type": "boolean"},
        "required_sections": {
          "type": "array",
          "items": {"type": "string"}
        },
        "optional_sections": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required": {"type": "boolean"},
        "required_summary": {"type": "boolean"},
        "required_sections": {
          "type": "array",
          "items": {"type": "string"}
        },
        "optional_sections": {
          "type": "array",
          "items": {"type": "string"}
        },
        "ownership_registry": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "section": {"type": "string"},
            "allows_multiple": {"type": "boolean"}
          }
        }
      }
    },
    "check_categories": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "formatting": {
          "type": "array",
          "items": {
            "type": ["string", "object"],
            "properties": {
              "code": {"type": "string"},
              "intent": {"type": "string"}
            }
          }
        },
        "behavioral": {
          "type": "array",
          "items": {
            "type": ["string", "object"],
            "properties": {
              "code": {"type": "string"},
              "intent": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
