{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://officina/references/standards/docstring_format.schema.json",
  "title": "Docstring Format Schema",
  "description": "JSON Schema for the declarative docstring policy used by officina common docstring components.",
  "type": "object",
  "additionalProperties": true,
  "required": ["docstring_format_version", "name", "callable"],
  "properties": {
    "docstring_schema_version": {
      "type": "integer",
      "minimum": 1,
    "description": "Legacy alias kept for compatibility with earlier schema naming.",
    "examples": [23]
    },
    "docstring_format_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Current policy version for this docstring format contract.",
      "examples": [23]
    },
    "name": {
      "type": "string",
      "description": "Stable contract identifier used by diagnostics and tooling.",
      "examples": ["docstring_format"]
    },
    "strict": {
      "type": "boolean",
      "description": "When true, required-section checks are enforced and reported as warnings."
    },
    "callable": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required_summary": {
          "type": "boolean"
        },
        "summary_min_chars": {
          "type": "integer",
          "minimum": 0
        },
        "summary_max_chars": {
          "type": "integer",
          "minimum": 0
        },
        "rationale_min_chars": {
          "type": "integer",
          "minimum": 0
        },
        "rationale_max_chars": {
          "type": "integer",
          "minimum": 0
        },
        "required_sections": {
          "type": "array",
          "items": {"type": "string"}
        },
        "compact_structural_kinds": {
          "type": "array",
          "items": {
            "enum": ["stdlib_dataclass", "builtin_exception"]
          },
          "uniqueItems": true,
          "maxItems": 2
        },
        "optional_sections": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_summary_phrases": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_intent_phrases": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_rationale_phrases": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_pseudocode_phrases": {
          "type": "array",
          "items": {"type": "string"}
        },
        "min_pseudocode_steps": {
          "type": "integer",
          "minimum": 0
        },
        "dependency_reference_sections": {
          "type": "array",
          "items": {"type": "string"}
        },
        "pseudocode": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "section": {"type": "string"},
            "min_steps": {"type": "integer", "minimum": 0},
            "max_steps": {"type": "integer", "minimum": 0},
            "max_step_chars": {"type": "integer", "minimum": 0},
            "max_total_chars": {"type": "integer", "minimum": 0}
          }
        },
        "module_dependencies": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "calls_section": {"type": "string"},
            "instantiates_section": {"type": "string"},
            "dispatches_section": {"type": "string"},
            "allow_implicit": {"type": "boolean"},
            "allow_legacy_flat": {"type": "boolean"},
            "require_why": {"type": "boolean"},
            "validate_declared_calls": {"type": "boolean"},
            "validate_declared_instantiations": {"type": "boolean"},
            "validate_declared_dispatches": {"type": "boolean"},
            "report_unlisted_calls": {"type": "boolean"},
            "report_unlisted_instantiations": {"type": "boolean"},
            "ignore_non_external": {"type": "boolean"},
            "validate_dependency_targets_resolved": {"type": "boolean"},
            "enforce_declared_dependency_pseudocode_coverage": {"type": "boolean"},
            "enforce_observed_dependency_pseudocode_coverage": {"type": "boolean"},
            "dependency_why": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "actions": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "allow_legacy_string": {"type": "boolean"},
                "misc_min_chars": {"type": "integer", "minimum": 0}
              }
            },
            "pseudocode_quality": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "forbidden_variables": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "require_assigned_dependency_output_use": {"type": "boolean"}
              }
            },
            "repeated_template_detection": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {"type": "boolean"},
                "min_repetitions": {"type": "integer", "minimum": 0},
                "min_normalized_chars": {"type": "integer", "minimum": 0}
              }
            },
            "forbidden_why_phrases": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        },
        "ownership": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "section": {"type": "string"},
            "section_required": {"type": "boolean"},
            "allows_multiple": {"type": "boolean"},
            "single_owner_per_callable": {"type": "boolean"},
            "owner_resolution": {"type": "string"},
            "cross_file": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required": {"type": "boolean"},
        "required_sections": {
          "type": "array",
          "items": {"type": "string"}
        },
        "optional_sections": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required": {"type": "boolean"},
        "required_summary": {"type": "boolean"},
        "required_sections": {
          "type": "array",
          "items": {"type": "string"}
        },
        "optional_sections": {
          "type": "array",
          "items": {"type": "string"}
        },
        "ownership_registry": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "section": {"type": "string"},
            "allows_multiple": {"type": "boolean"}
          }
        }
      }
    },
    "check_categories": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "formatting": {
          "type": "array",
          "items": {
            "type": ["string", "object"],
            "properties": {
              "code": {"type": "string"},
              "intent": {"type": "string"}
            }
          }
        },
        "behavioral": {
          "type": "array",
          "items": {
            "type": ["string", "object"],
            "properties": {
              "code": {"type": "string"},
              "intent": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
