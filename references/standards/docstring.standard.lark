// `module_dependency` is the legacy flat dependency line syntax. Canonical
// dependency sections are YAML-like trees parsed by the Python policy layer.
?start: edge | wraps | module_dependency | pseudocode_bullet | pseudocode_ref_expr

IDENT: /\.?[A-Za-z_][A-Za-z0-9_-]*(?:\.[A-Za-z_][A-Za-z0-9_-]*)*/
PSEUDO_REF.2: /\.?[A-Za-z0-9_][A-Za-z0-9_-]*(?:\.[A-Za-z0-9_][A-Za-z0-9_-]*)*/
PSEUDO_VAR.3: /[A-Za-z_][A-Za-z0-9_]*/
PSEUDO_INDENT: /(?:  )+/
PSEUDO_EXPR.5: /[^\n]+/
PSEUDO_ARGS: /\([^\n]*\)/
RESOURCE_ID: /[A-Za-z0-9_.-]+/
PSEUDO_IF_LINE.20: /if [^:\n]+:/
PSEUDO_WHILE_LINE.20: /while [^:\n]+:/
PSEUDO_FOR_LINE.20: /for [A-Za-z_][A-Za-z0-9_]* in [^:\n]+:/
PSEUDO_ELSE_LINE.20: "else:"
PSEUDO_RETURN_LINE.20: /return(?: [^\n]+)?/
PSEUDO_RAISE_LINE.10: /raise [^\n]+/
YIELD.10: /yield(?![A-Za-z0-9_])/
IF.10: /if(?![A-Za-z0-9_])/
WHILE.10: /while(?![A-Za-z0-9_])/
FOR.10: /for(?![A-Za-z0-9_])/
IN.10: /in(?![A-Za-z0-9_])/
ELSE.10: /else(?![A-Za-z0-9_])/
SET.10: /set(?![A-Za-z0-9_])/
READ.10: /read(?![A-Za-z0-9_])/
WRITE.10: /write(?![A-Za-z0-9_])/
RETURN.10: /return(?![A-Za-z0-9_])/
RAISE.10: /raise(?![A-Za-z0-9_])/
CONTINUE.10: /continue(?![A-Za-z0-9_])/
BREAK.10: /break(?![A-Za-z0-9_])/

edge: name WS* ARROW WS* name
wraps: WRAP_NONE | name [WS* ARROW WS* wrap_fields]
WRAP_NONE: /[Nn][oO][nN][eE]/
wrap_fields: wrap_field (WS* ";" WS* wrap_field)*
wrap_field: WRAP_KEY WS* ":" WS* WRAP_VALUE
WRAP_KEY.10: "preprocess" | "postprocess" | "fixed_arguments" | "fixed_argument" | "fixed_args" | "pre" | "post" | "fixed"
WRAP_VALUE: /[^\s;\n][^;\n]*/
module_dependency: name call_args? implicit_marker? dependency_why
call_args: /\([^)]*\)/
implicit_marker: "[implicit]"
DEPS_RATIONALE: /[^-\n][^\n]*/
dependency_why: ARROW DEPS_RATIONALE
name: IDENT
ARROW.10: "->"
pseudocode_bullet: PSEUDO_INDENT? "- " pseudocode_line
pseudocode_line: pseudocode_call | pseudocode_dispatch | pseudocode_instantiate | pseudocode_set | pseudocode_resource | pseudocode_control | pseudocode_terminal
pseudocode_ref_expr: pseudocode_call_ref | pseudocode_dispatch_ref | pseudocode_product_ref
pseudocode_call_ref: "@" PSEUDO_REF PSEUDO_ARGS
pseudocode_dispatch_ref: "#" PSEUDO_REF PSEUDO_ARGS
pseudocode_product_ref: PSEUDO_REF PSEUDO_ARGS
pseudocode_call: [PSEUDO_VAR " = "] pseudocode_call_ref
pseudocode_dispatch: [PSEUDO_VAR " = "] pseudocode_dispatch_ref
pseudocode_instantiate: PSEUDO_VAR " = " pseudocode_product_ref | RETURN WS+ pseudocode_product_ref | RAISE WS+ pseudocode_product_ref | YIELD WS+ pseudocode_product_ref
pseudocode_set: SET WS+ PSEUDO_VAR " = " PSEUDO_EXPR
pseudocode_resource: (READ | WRITE) WS+ RESOURCE_ID
pseudocode_control: PSEUDO_IF_LINE | PSEUDO_WHILE_LINE | PSEUDO_FOR_LINE | PSEUDO_ELSE_LINE
pseudocode_terminal: PSEUDO_RETURN_LINE | PSEUDO_RAISE_LINE | CONTINUE | BREAK

%import common.WS
