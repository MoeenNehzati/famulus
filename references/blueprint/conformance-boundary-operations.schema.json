{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "conformance-boundary-operations.schema.json",
  "title": "Conformance Boundary Operation Registry",
  "type": "object",
  "required": ["schema_version", "stable_errors", "boundaries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "stable_errors": {
      "type": "array",
      "const": ["invalid-request", "unavailable", "fixture-missing", "forbidden", "adapter-failure"]
    },
    "boundaries": {
      "type": "object",
      "required": ["filesystem", "clock", "network", "helpers", "subprocess", "calendar", "email"],
      "additionalProperties": false,
      "properties": {
        "filesystem": {"$ref": "#/definitions/filesystemOperations"},
        "clock": {"$ref": "#/definitions/clockOperations"},
        "network": {"$ref": "#/definitions/networkOperations"},
        "helpers": {"$ref": "#/definitions/helperOperations"},
        "subprocess": {"$ref": "#/definitions/subprocessOperations"},
        "calendar": {"$ref": "#/definitions/calendarOperations"},
        "email": {"$ref": "#/definitions/emailOperations"}
      }
    }
  },
  "definitions": {
    "schemaLocator": {
      "type": "object",
      "required": ["path", "fragment"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "pattern": "^conformance-operations/[a-z]+\\.schema\\.json$"},
        "fragment": {"type": "string", "pattern": "^#/definitions/[a-z][A-Za-z]+$"}
      }
    },
    "operation": {
      "type": "object",
      "required": ["request_schema", "success_schema", "permitted_errors", "effect_class"],
      "additionalProperties": false,
      "properties": {
        "request_schema": {"$ref": "#/definitions/schemaLocator"},
        "success_schema": {"$ref": "#/definitions/schemaLocator"},
        "permitted_errors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["invalid-request", "unavailable", "fixture-missing", "forbidden", "adapter-failure"]}
        },
        "effect_class": {"enum": ["read", "write", "delete", "time", "network", "invoke", "execute", "send"]}
      }
    },
    "filesystemOperations": {"type": "object", "required": ["read", "write", "stat", "list", "delete"], "additionalProperties": false, "properties": {"read": {"$ref": "#/definitions/operation"}, "write": {"$ref": "#/definitions/operation"}, "stat": {"$ref": "#/definitions/operation"}, "list": {"$ref": "#/definitions/operation"}, "delete": {"$ref": "#/definitions/operation"}}},
    "clockOperations": {"type": "object", "required": ["now", "advance"], "additionalProperties": false, "properties": {"now": {"$ref": "#/definitions/operation"}, "advance": {"$ref": "#/definitions/operation"}}},
    "networkOperations": {"type": "object", "required": ["request"], "additionalProperties": false, "properties": {"request": {"$ref": "#/definitions/operation"}}},
    "helperOperations": {"type": "object", "required": ["invoke"], "additionalProperties": false, "properties": {"invoke": {"$ref": "#/definitions/operation"}}},
    "subprocessOperations": {"type": "object", "required": ["run"], "additionalProperties": false, "properties": {"run": {"$ref": "#/definitions/operation"}}},
    "calendarOperations": {"type": "object", "required": ["list", "create", "update", "delete"], "additionalProperties": false, "properties": {"list": {"$ref": "#/definitions/operation"}, "create": {"$ref": "#/definitions/operation"}, "update": {"$ref": "#/definitions/operation"}, "delete": {"$ref": "#/definitions/operation"}}},
    "emailOperations": {"type": "object", "required": ["list", "read", "search", "send"], "additionalProperties": false, "properties": {"list": {"$ref": "#/definitions/operation"}, "read": {"$ref": "#/definitions/operation"}, "search": {"$ref": "#/definitions/operation"}, "send": {"$ref": "#/definitions/operation"}}}
  }
}
