{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "behavioral-source.schema.json",
  "title": "Behavioral Source Blueprint",
  "description": "Closed version 4 contract for one source-owned behavioral implementation and its intrinsic interfaces.",
  "type": "object",
  "required": ["schema_version", "node_type", "id", "version", "description", "gateway", "content", "dependencies", "uses_interfaces", "interfaces"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 4,
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": 4}, "doc": {"authoring": ["Use unified blueprint schema version 4."]}, "related_validation_rules": ["schema-shape"]}
    },
    "node_type": {
      "const": "behavioral_source",
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": "behavioral_source"}, "doc": {"authoring": ["Identify this node as a behavioral source."]}, "related_validation_rules": ["schema-shape"]}
    },
    "id": {
      "$ref": "common.schema.json#/definitions/behavioralSourceId",
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": "example-skill.source.gateway"}, "doc": {"authoring": ["Use <module>.source.<local-source-id>."]}, "related_validation_rules": ["canonical-id"]}
    },
    "version": {
      "$ref": "common.schema.json#/definitions/interfaceVersion",
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": 1}, "doc": {"authoring": ["Increment when the behavioral-source contract changes."]}, "related_validation_rules": ["version-pin"]}
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": "Owns the primary instructions."}, "doc": {"authoring": ["Describe this source's intrinsic behavioral role."]}, "related_validation_rules": ["schema-shape"]}
    },
    "gateway": {
      "$ref": "common.schema.json#/definitions/gateway",
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": {"path": "SKILL.md", "language": "Markdown"}}, "doc": {"authoring": ["Name the source's whole-file gateway and language requirement."]}, "related_validation_rules": ["gateway-file", "content-files"]}
    },
    "content": {
      "$ref": "common.schema.json#/definitions/contentPatterns",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": ["SKILL\\.md"]}, "doc": {"authoring": ["Match every file directly owned by this source; the gateway must match."]}, "related_validation_rules": ["content-files", "content-exclusive", "commit-backed-stamp"]}
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/definitions/sourceDependency"},
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": []}, "doc": {"authoring": ["Declare direct behavioral-source dependencies with exact versions and reasons."]}, "related_validation_rules": ["behavior-source-edge", "version-pin"]}
    },
    "uses_interfaces": {
      "$ref": "common.schema.json#/definitions/interfaceUseList",
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": []}, "doc": {"authoring": ["Declare every sibling private interface or module export this source uses."]}, "related_validation_rules": ["relationship-edge", "version-pin"]}
    },
    "interfaces": {
      "type": "object",
      "propertyNames": {"$ref": "common.schema.json#/definitions/sourceInterfaceId"},
      "additionalProperties": {"$ref": "#/definitions/interface"},
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": {}}, "doc": {"authoring": ["Define intrinsic interfaces keyed by their full canonical source-interface IDs."]}, "related_validation_rules": ["canonical-id", "relationship-edge"]}
    }
  },
  "definitions": {
    "interface": {
      "type": "object",
      "required": ["version", "description", "contract"],
      "additionalProperties": false,
      "properties": {
        "version": {"$ref": "common.schema.json#/definitions/interfaceVersion"},
        "description": {"type": "string", "minLength": 1},
        "contract": {"$ref": "caller-contract.schema.json"},
        "process_binding": {"$ref": "caller-contract.schema.json#/definitions/processBinding"}
      }
    }
  },
  "x-famulus": {
    "audit_hash": "include",
    "gateway_policy": "whole-file",
    "allowed_edge_types": ["behavioral_source", "interface"]
  }
}
