{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "conformance-operations/filesystem.schema.json",
  "definitions": {
    "pathOnly": {"type": "object", "required": ["path"], "additionalProperties": false, "properties": {"path": {"$ref": "common.schema.json#/definitions/relativePath"}}},
    "readRequest": {"type": "object", "required": ["operation_version", "parameters"], "additionalProperties": false, "properties": {"operation_version": {"const": 1}, "parameters": {"$ref": "#/definitions/pathOnly"}}},
    "readSuccess": {"type": "object", "required": ["ok", "result"], "additionalProperties": false, "properties": {"ok": {"const": true}, "result": {"type": "object", "required": ["content", "encoding"], "additionalProperties": false, "properties": {"content": {"type": "string"}, "encoding": {"const": "utf-8"}}}}},
    "writeRequest": {"type": "object", "required": ["operation_version", "parameters"], "additionalProperties": false, "properties": {"operation_version": {"const": 1}, "parameters": {"type": "object", "required": ["path", "content", "encoding"], "additionalProperties": false, "properties": {"path": {"$ref": "common.schema.json#/definitions/relativePath"}, "content": {"type": "string"}, "encoding": {"const": "utf-8"}}}}},
    "writeSuccess": {"type": "object", "required": ["ok", "result"], "additionalProperties": false, "properties": {"ok": {"const": true}, "result": {"type": "object", "required": ["bytes_written"], "additionalProperties": false, "properties": {"bytes_written": {"type": "integer", "minimum": 0}}}}},
    "statRequest": {"type": "object", "required": ["operation_version", "parameters"], "additionalProperties": false, "properties": {"operation_version": {"const": 1}, "parameters": {"$ref": "#/definitions/pathOnly"}}},
    "statSuccess": {"type": "object", "required": ["ok", "result"], "additionalProperties": false, "properties": {"ok": {"const": true}, "result": {"type": "object", "required": ["kind", "size"], "additionalProperties": false, "properties": {"kind": {"enum": ["file", "directory"]}, "size": {"type": "integer", "minimum": 0}}}}},
    "listRequest": {"type": "object", "required": ["operation_version", "parameters"], "additionalProperties": false, "properties": {"operation_version": {"const": 1}, "parameters": {"$ref": "#/definitions/pathOnly"}}},
    "listSuccess": {"type": "object", "required": ["ok", "result"], "additionalProperties": false, "properties": {"ok": {"const": true}, "result": {"type": "object", "required": ["entries"], "additionalProperties": false, "properties": {"entries": {"type": "array", "items": {"type": "string", "minLength": 1}}}}}},
    "deleteRequest": {"type": "object", "required": ["operation_version", "parameters"], "additionalProperties": false, "properties": {"operation_version": {"const": 1}, "parameters": {"$ref": "#/definitions/pathOnly"}}},
    "deleteSuccess": {"type": "object", "required": ["ok", "result"], "additionalProperties": false, "properties": {"ok": {"const": true}, "result": {"type": "object", "required": ["deleted"], "additionalProperties": false, "properties": {"deleted": {"const": true}}}}},
    "error": {"$ref": "common.schema.json#/definitions/error"}
  }
}
