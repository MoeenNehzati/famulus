{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "conformance-operations/email.schema.json",
  "definitions": {
    "messageSummary": {"type": "object", "required": ["id", "subject"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "subject": {"type": "string"}}},
    "message": {"type": "object", "required": ["id", "from", "to", "subject", "body"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "from": {"type": "string", "minLength": 1}, "to": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "subject": {"type": "string"}, "body": {"type": "string"}}},
    "listRequest": {"type": "object", "required": ["operation_version", "parameters"], "additionalProperties": false, "properties": {"operation_version": {"const": 1}, "parameters": {"type": "object", "required": ["account", "mailbox"], "additionalProperties": false, "properties": {"account": {"type": "string", "minLength": 1}, "mailbox": {"type": "string", "minLength": 1}}}}},
    "listSuccess": {"type": "object", "required": ["ok", "result"], "additionalProperties": false, "properties": {"ok": {"const": true}, "result": {"type": "object", "required": ["messages"], "additionalProperties": false, "properties": {"messages": {"type": "array", "items": {"$ref": "#/definitions/messageSummary"}}}}}},
    "readRequest": {"type": "object", "required": ["operation_version", "parameters"], "additionalProperties": false, "properties": {"operation_version": {"const": 1}, "parameters": {"type": "object", "required": ["account", "message_id"], "additionalProperties": false, "properties": {"account": {"type": "string", "minLength": 1}, "message_id": {"type": "string", "minLength": 1}}}}},
    "readSuccess": {"type": "object", "required": ["ok", "result"], "additionalProperties": false, "properties": {"ok": {"const": true}, "result": {"type": "object", "required": ["message"], "additionalProperties": false, "properties": {"message": {"$ref": "#/definitions/message"}}}}},
    "searchRequest": {"type": "object", "required": ["operation_version", "parameters"], "additionalProperties": false, "properties": {"operation_version": {"const": 1}, "parameters": {"type": "object", "required": ["account", "query"], "additionalProperties": false, "properties": {"account": {"type": "string", "minLength": 1}, "query": {"type": "string", "minLength": 1}}}}},
    "searchSuccess": {"$ref": "#/definitions/listSuccess"},
    "sendRequest": {"type": "object", "required": ["operation_version", "parameters"], "additionalProperties": false, "properties": {"operation_version": {"const": 1}, "parameters": {"type": "object", "required": ["account", "to", "subject", "body"], "additionalProperties": false, "properties": {"account": {"type": "string", "minLength": 1}, "to": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "subject": {"type": "string"}, "body": {"type": "string"}}}}},
    "sendSuccess": {"type": "object", "required": ["ok", "result"], "additionalProperties": false, "properties": {"ok": {"const": true}, "result": {"type": "object", "required": ["message_id"], "additionalProperties": false, "properties": {"message_id": {"type": "string", "minLength": 1}}}}},
    "error": {"$ref": "common.schema.json#/definitions/error"}
  }
}
