{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "conformance-operations/calendar.schema.json",
  "definitions": {
    "event": {"type": "object", "required": ["id", "title", "start", "end"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}},
    "listRequest": {"type": "object", "required": ["operation_version", "parameters"], "additionalProperties": false, "properties": {"operation_version": {"const": 1}, "parameters": {"type": "object", "required": ["calendar", "start", "end"], "additionalProperties": false, "properties": {"calendar": {"type": "string", "minLength": 1}, "start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}}}},
    "listSuccess": {"type": "object", "required": ["ok", "result"], "additionalProperties": false, "properties": {"ok": {"const": true}, "result": {"type": "object", "required": ["events"], "additionalProperties": false, "properties": {"events": {"type": "array", "items": {"$ref": "#/definitions/event"}}}}}},
    "createRequest": {"type": "object", "required": ["operation_version", "parameters"], "additionalProperties": false, "properties": {"operation_version": {"const": 1}, "parameters": {"type": "object", "required": ["calendar", "event"], "additionalProperties": false, "properties": {"calendar": {"type": "string", "minLength": 1}, "event": {"$ref": "#/definitions/event"}}}}},
    "createSuccess": {"type": "object", "required": ["ok", "result"], "additionalProperties": false, "properties": {"ok": {"const": true}, "result": {"type": "object", "required": ["event"], "additionalProperties": false, "properties": {"event": {"$ref": "#/definitions/event"}}}}},
    "updateRequest": {"type": "object", "required": ["operation_version", "parameters"], "additionalProperties": false, "properties": {"operation_version": {"const": 1}, "parameters": {"type": "object", "required": ["calendar", "event"], "additionalProperties": false, "properties": {"calendar": {"type": "string", "minLength": 1}, "event": {"$ref": "#/definitions/event"}}}}},
    "updateSuccess": {"$ref": "#/definitions/createSuccess"},
    "deleteRequest": {"type": "object", "required": ["operation_version", "parameters"], "additionalProperties": false, "properties": {"operation_version": {"const": 1}, "parameters": {"type": "object", "required": ["calendar", "event_id"], "additionalProperties": false, "properties": {"calendar": {"type": "string", "minLength": 1}, "event_id": {"type": "string", "minLength": 1}}}}},
    "deleteSuccess": {"type": "object", "required": ["ok", "result"], "additionalProperties": false, "properties": {"ok": {"const": true}, "result": {"type": "object", "required": ["deleted"], "additionalProperties": false, "properties": {"deleted": {"const": true}}}}},
    "error": {"$ref": "common.schema.json#/definitions/error"}
  }
}
