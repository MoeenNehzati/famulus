{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "title": "Version 5 Blueprint Common Definitions",
  "definitions": {
    "requirement": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9.+_-]*(?:(?:==|>=|>|<=|<)[A-Za-z0-9][A-Za-z0-9._-]*(?:,(?:==|>=|>|<=|<)[A-Za-z0-9][A-Za-z0-9._-]*)*)?$",
      "description": "A language or machine requirement: a name, an exact version, or a comma-separated intersection of version constraints."
    },
    "interfaceVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Human-managed interface contract version."
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativeModuleReference": {
      "type": "string",
      "pattern": "^\\.+(?:_rtx|[a-z0-9]+(?:-[a-z0-9]+)*)(?:\\.(?:_rtx|[a-z0-9]+(?:-[a-z0-9]+)*))*$",
      "description": "An exact module reference relative to the declaration owner. The first dot starts at the owner and each additional leading dot ascends one registered parent."
    },
    "callerReference": {
      "oneOf": [
        {"$ref": "#/definitions/moduleId"},
        {"$ref": "#/definitions/relativeModuleReference"}
      ],
      "description": "One exact global module ID or leading-dot relative module reference."
    },
    "behavioralSourceId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.source\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceInterfaceId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.source\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.interface\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "exportInterfaceId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.interface\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "interfaceId": {
      "oneOf": [
        {"$ref": "#/definitions/sourceInterfaceId"},
        {"$ref": "#/definitions/exportInterfaceId"}
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+",
      "description": "Relative path without parent traversal. Filesystem validators additionally require the expected file type."
    },
    "contentPatterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "description": "Case-sensitive Python regular expressions matched with re.fullmatch against normalized POSIX paths under the node ownership root."
    },
    "v5BlueprintLocator": {
      "type": "object",
      "required": ["base", "path"],
      "additionalProperties": false,
      "properties": {
        "base": {
          "enum": ["module-root", "repository-root"],
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": "module-root"},
            "doc": {"authoring": ["Choose the root against which the blueprint path is resolved."]},
            "related_validation_rules": ["gateway-file"]
          }
        },
        "path": {
          "$ref": "#/definitions/relativePath",
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": "blueprints/gateway.yaml"},
            "doc": {"authoring": ["Name the target blueprint without parent traversal."]},
            "related_validation_rules": ["gateway-file"]
          }
        }
      }
    },
    "childBlueprintLocator": {
      "type": "object",
      "required": ["base", "path"],
      "additionalProperties": false,
      "properties": {
        "base": {
          "const": "module-root",
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": "module-root"},
            "doc": {"authoring": ["Resolve every direct-child marker from its parent module root."]},
            "related_validation_rules": ["nested-topology"]
          }
        },
        "path": {
          "allOf": [
            {"$ref": "#/definitions/relativePath"},
            {"pattern": "(?:^|/)blueprint\\.yaml$"}
          ],
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": "_rtx/blueprint.yaml"},
            "doc": {"authoring": ["Name the direct child's canonical blueprint.yaml marker without parent traversal."]},
            "related_validation_rules": ["nested-topology"]
          }
        }
      }
    },
    "contractReference": {
      "type": "object",
      "required": ["base", "path"],
      "additionalProperties": false,
      "properties": {
        "base": {
          "enum": ["module-root", "repository-root"],
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": "module-root"},
            "doc": {"authoring": ["Choose the root against which the contract path is resolved."]},
            "related_validation_rules": ["relationship-edge"]
          }
        },
        "path": {
          "$ref": "#/definitions/relativePath",
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": "contracts/schema.json"},
            "doc": {"authoring": ["Name the authored contract path without parent traversal."]},
            "related_validation_rules": ["relationship-edge"]
          }
        },
        "fragment": {
          "type": "string",
          "pattern": "^#",
          "x-famulus": {
            "field_status": "optional",
            "template": {"include": false},
            "doc": {"authoring": ["Optionally select a JSON Pointer fragment; omit for the whole document."]},
            "related_validation_rules": ["relationship-edge"]
          }
        }
      }
    },
    "sourceContainment": {
      "type": "object",
      "required": ["blueprint"],
      "additionalProperties": false,
      "properties": {
        "blueprint": {
          "$ref": "#/definitions/v5BlueprintLocator",
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": {"base": "module-root", "path": "blueprints/gateway.yaml"}},
            "doc": {"authoring": ["Point to the contained behavioral source blueprint; its version remains source-owned."]},
            "related_validation_rules": ["relationship-edge"]
          }
        }
      }
    },
    "sourceDependency": {
      "type": "object",
      "required": ["source", "version", "blueprint", "reason"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/definitions/behavioralSourceId",
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": "other-skill.source.policy"},
            "doc": {"authoring": ["Name the direct behavioral-source dependency."]},
            "related_validation_rules": ["behavioral-source-edge"]
          }
        },
        "version": {
          "$ref": "#/definitions/interfaceVersion",
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": 1},
            "doc": {"authoring": ["Pin the exact dependency version required by this source."]},
            "related_validation_rules": ["version-pin"]
          }
        },
        "blueprint": {
          "$ref": "#/definitions/v5BlueprintLocator",
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": {"base": "module-root", "path": "blueprints/policy.yaml"}},
            "doc": {"authoring": ["Point to the dependency's behavioral-source blueprint."]},
            "related_validation_rules": ["relationship-edge"]
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": "Supplies policy."},
            "doc": {"authoring": ["State why this source directly depends on the target."]},
            "related_validation_rules": ["behavioral-source-edge"]
          }
        }
      }
    },
    "interfaceUse": {
      "type": "object",
      "required": ["interface", "version"],
      "additionalProperties": false,
      "properties": {
        "interface": {
          "$ref": "#/definitions/interfaceId",
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": "other-skill.interface.read"},
            "doc": {"authoring": ["Name a sibling private source interface or a module export."]},
            "related_validation_rules": ["relationship-edge"]
          }
        },
        "version": {
          "$ref": "#/definitions/interfaceVersion",
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": 1},
            "doc": {"authoring": ["Pin the exact interface version required by this source."]},
            "related_validation_rules": ["version-pin"]
          }
        }
      }
    },
    "interfaceUseList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/interfaceUse"}
    },
    "gateway": {
      "type": "object",
      "required": ["path", "language"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/definitions/relativePath",
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": "SKILL.md"},
            "doc": {"authoring": ["Name exactly one existing whole-file gateway without parent traversal."]},
            "related_validation_rules": ["gateway-file"]
          }
        },
        "language": {
          "$ref": "#/definitions/requirement",
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": "Markdown"},
            "doc": {"authoring": ["Declare the language or notation consumed through the gateway."]},
            "related_validation_rules": ["schema-shape"]
          }
        },
        "machines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/requirement"},
          "x-famulus": {
            "field_status": "optional",
            "template": {"include": false},
            "doc": {"authoring": ["List alternative machine requirements known to consume the gateway."]},
            "related_validation_rules": ["runtime-dependency"]
          }
        }
      },
      "description": "A whole-file gateway plus its language and optional alternative machine requirements."
    },
    "platformSupport": {
      "type": "object",
      "required": ["linux", "macos", "windows"],
      "additionalProperties": false,
      "properties": {
        "linux": {
          "type": "boolean",
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": true},
            "doc": {"authoring": ["State whether the source supports Linux."]},
            "related_validation_rules": ["runtime-dependency"]
          }
        },
        "macos": {
          "type": "boolean",
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": true},
            "doc": {"authoring": ["State whether the source supports macOS."]},
            "related_validation_rules": ["runtime-dependency"]
          }
        },
        "windows": {
          "type": "boolean",
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": true},
            "doc": {"authoring": ["State whether the source supports Windows."]},
            "related_validation_rules": ["runtime-dependency"]
          }
        }
      }
    },
    "runtimeDependencyKind": {
      "type": "string",
      "enum": [
        "python-package",
        "binary",
        "system-service",
        "system-library",
        "external-application",
        "runtime",
        "model-data"
      ]
    },
    "runtimeSystemServiceName": {
      "type": "string",
      "description": "Standardized service-manager or daemon facility names for runtime dependencies.",
      "enum": ["systemd-user", "launchd", "task-scheduler", "cron"]
    },
    "runtimeDependency": {
      "type": "object",
      "required": ["kind", "name", "version", "platforms", "reason"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/definitions/runtimeDependencyKind",
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": "python-package"},
            "doc": {"authoring": ["Classify the runtime dependency."]},
            "related_validation_rules": ["runtime-dependency"]
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+\\-\\[\\]]*$",
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": "PyYAML"},
            "doc": {"authoring": ["Name the package, executable, service, library, runtime, application, or model data."]},
            "related_validation_rules": ["runtime-dependency"]
          }
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": ">=6"},
            "doc": {"authoring": ["State the required dependency version or constraint."]},
            "related_validation_rules": ["runtime-dependency"]
          }
        },
        "platforms": {
          "$ref": "#/definitions/platformSupport",
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": {"linux": true, "macos": true, "windows": true}},
            "doc": {"authoring": ["State the platforms on which this dependency applies."]},
            "related_validation_rules": ["runtime-dependency"]
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "x-famulus": {
            "field_status": "required",
            "template": {"include": true, "example": "Parses YAML blueprints."},
            "doc": {"authoring": ["Explain why the source requires this dependency."]},
            "related_validation_rules": ["runtime-dependency"]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "system-service"}},
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "name": {"$ref": "#/definitions/runtimeSystemServiceName"}
            }
          }
        }
      ]
    },
    "runtimeDependencies": {
      "type": "array",
      "description": "Non-stdlib runtime dependencies for one behavioral source. Each platforms map states where the dependency applies, not the source's complete support claim.",
      "items": {"$ref": "#/definitions/runtimeDependency"},
      "uniqueItems": true
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "x-famulus": {"field_status": "optional", "template": {"include": false}, "doc": {"authoring": ["Optionally name this accepted argv pattern."]}, "related_validation_rules": ["dispatcher-argv-pattern"]}},
        "min_positionals": {"type": "integer", "minimum": 0, "x-famulus": {"field_status": "optional", "template": {"include": false}, "doc": {"authoring": ["Set the minimum number of positional arguments accepted."]}, "related_validation_rules": ["dispatcher-argv-pattern"]}},
        "max_positionals": {"type": "integer", "minimum": 0, "x-famulus": {"field_status": "optional", "template": {"include": false}, "doc": {"authoring": ["Set the maximum number of positional arguments accepted."]}, "related_validation_rules": ["dispatcher-argv-pattern"]}},
        "allow_extra_positionals": {"type": "boolean", "default": false, "x-famulus": {"field_status": "optional", "template": {"include": false}, "doc": {"authoring": ["Allow positional arguments beyond the declared maximum or positional patterns."]}, "related_validation_rules": ["dispatcher-argv-pattern"]}},
        "allow_stdin": {"type": "boolean", "default": false, "x-famulus": {"field_status": "optional", "template": {"include": false}, "doc": {"authoring": ["Allow the interface to consume standard input."]}, "related_validation_rules": ["dispatcher-argv-pattern"]}},
        "positional_patterns": {
          "type": "object",
          "propertyNames": {"pattern": "^[0-9]+$"},
          "additionalProperties": {"type": "string", "minLength": 1},
          "x-famulus": {"field_status": "optional", "template": {"include": false}, "doc": {"authoring": ["Map zero-based positional indexes to their accepted regular expressions."]}, "related_validation_rules": ["dispatcher-argv-pattern"]}
        },
        "flag_patterns": {
          "type": "object",
          "propertyNames": {"pattern": "^-{1,2}[A-Za-z0-9][A-Za-z0-9-]*$"},
          "additionalProperties": {"type": "string", "minLength": 1},
          "x-famulus": {"field_status": "optional", "template": {"include": false}, "doc": {"authoring": ["Map accepted short or long flags to value regular expressions."]}, "related_validation_rules": ["dispatcher-argv-pattern"]}
        },
        "required_flags": {
          "type": "array",
          "items": {"type": "string", "pattern": "^-{1,2}[A-Za-z0-9][A-Za-z0-9-]*$"},
          "x-famulus": {"field_status": "optional", "template": {"include": false}, "doc": {"authoring": ["List flags that every matching invocation must contain."]}, "related_validation_rules": ["dispatcher-argv-pattern"]}
        },
        "allowed_flags": {
          "type": "array",
          "items": {"type": "string", "pattern": "^-{1,2}[A-Za-z0-9][A-Za-z0-9-]*$"},
          "x-famulus": {"field_status": "optional", "template": {"include": false}, "doc": {"authoring": ["List the complete set of flags accepted by this pattern."]}, "related_validation_rules": ["dispatcher-argv-pattern"]}
        },
        "forbidden_flags": {
          "type": "array",
          "items": {"type": "string", "pattern": "^-{1,2}[A-Za-z0-9][A-Za-z0-9-]*$"},
          "x-famulus": {"field_status": "optional", "template": {"include": false}, "doc": {"authoring": ["List flags explicitly rejected by this pattern."]}, "related_validation_rules": ["dispatcher-argv-pattern"]}
        },
        "notes": {"type": "string", "minLength": 1, "x-famulus": {"field_status": "optional", "template": {"include": false}, "doc": {"authoring": ["Record concise semantic details not expressible by the structural fields."]}, "related_validation_rules": ["dispatcher-argv-pattern"]}}
      }
    },
    "v4FilesystemOwnershipList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["match", "path", "allowed_readers"],
        "additionalProperties": false,
        "properties": {
          "match": {"enum": ["exact", "regex"], "x-famulus": {"field_status": "required", "template": {"include": true, "example": "exact"}, "doc": {"authoring": ["Choose exact or regex path matching."]}, "related_validation_rules": ["filesystem-ownership"]}},
          "path": {"type": "string", "minLength": 1, "x-famulus": {"field_status": "required", "template": {"include": true, "example": "state.json"}, "doc": {"authoring": ["Declare the module-owned filesystem path or pattern."]}, "related_validation_rules": ["filesystem-ownership"]}},
          "allowed_readers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/interfaceId"}, "x-famulus": {"field_status": "required", "template": {"include": true, "example": []}, "doc": {"authoring": ["List generic interface IDs authorized to read this owned path."]}, "related_validation_rules": ["filesystem-ownership"]}},
          "reason": {"type": "string", "minLength": 1, "x-famulus": {"field_status": "optional", "template": {"include": false}, "doc": {"authoring": ["Explain the module's filesystem authority when useful."]}, "related_validation_rules": ["filesystem-ownership"]}}
        }
      }
    }
  },
  "x-famulus": {
    "content_ownership_policy": {
      "gateway": "The whole-file gateway belongs to the authored ownership scope and mandatory certificate closure.",
      "content": "Content patterns declare ownership only; the project node-input policy selects hash inputs from that ownership scope."
    }
  }
}
