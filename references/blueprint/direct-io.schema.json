{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "direct-io.schema.json",
  "title": "Interface Direct I/O",
  "description": "Immediate source-owned interface semantic I/O. Relative private tmp/ and logs/ access may be omitted only when it is purely ephemeral or diagnostic and cannot affect output, verification, persistence, or later invocations.",
  "x-famulus": {
    "doc": {
      "authoring": [
        "Declare only immediate source-interface I/O; never copy transitive tool I/O.",
        "Private relative tmp/ and logs/ paths may be omitted only when purely ephemeral or diagnostic and behaviorally irrelevant."
      ]
    }
  },
  "type": "object",
  "required": ["reads", "writes", "network"],
  "additionalProperties": false,
  "properties": {
    "reads": {"type": "array", "items": {"$ref": "#/definitions/ioEntry"}},
    "writes": {"type": "array", "items": {"$ref": "#/definitions/ioEntry"}},
    "network": {"type": "array", "items": {"$ref": "#/definitions/ioEntry"}}
  },
  "definitions": {
    "authKind": {
      "type": "string",
      "enum": [
        "none",
        "google-calendar-oauth",
        "google-drive-oauth",
        "gmail-oauth",
        "email-account",
        "app-password",
        "rclone-config",
        "api-key",
        "keyring-entry",
        "local-user-session",
        "system-user",
        "agent-profile"
      ]
    },
    "authMode": {
      "type": "string",
      "enum": [
        "none",
        "uses-existing",
        "creates",
        "updates",
        "deletes",
        "checks"
      ]
    },
    "authRequirement": {
      "type": "object",
      "required": ["kind", "mode"],
      "additionalProperties": false,
      "properties": {
        "kind": {"$ref": "#/definitions/authKind"},
        "mode": {"$ref": "#/definitions/authMode"}
      }
    },
    "ioEntry": {
      "type": "object",
      "required": ["id", "medium", "access", "content", "sensitivity"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "medium": {"enum": ["local-filesystem", "remote-filesystem", "repository-filesystem", "home-filesystem", "temporary-filesystem", "network-request", "network", "prompt", "stdin", "stdout", "stderr", "local-system", "calendar", "email", "subprocess", "event-stream"]},
        "access": {"enum": ["read", "write", "read-write", "execute", "configure", "request", "download", "upload", "send", "delete"]},
        "system": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "auth": {"$ref": "#/definitions/authRequirement"},
        "sensitivity": {"enum": ["public", "user-private", "derived-private", "credential", "secret"]},
        "path": {"type": "string", "minLength": 1},
        "path_match": {"enum": ["exact", "glob", "regex"]},
        "reason": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "minLength": 1}
      }
    }
  }
}
