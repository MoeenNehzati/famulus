{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "interface-admissibility-profile.schema.json",
  "title": "Machine Export Admissibility Profile",
  "type": "object",
  "required": ["schema_version", "id", "version", "rules"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "id": {"const": "machine-export-admissibility"},
    "version": {"const": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^interface\\.[a-z0-9.-]+@[1-9][0-9]*$"},
          "version": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
