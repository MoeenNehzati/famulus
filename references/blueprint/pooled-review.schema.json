{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pooled-review.schema.json",
  "title": "Generated Pooled Blueprint Review",
  "description": "Expanded certificate-backed human-review artifact. It is not graph or certification authority.",
  "type": "object",
  "required": ["schema_version", "document_type", "generated_at", "root", "nodes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 2},
    "document_type": {"const": "pooled-blueprint-review"},
    "generated_at": {"type": ["string", "null"]},
    "root": {
      "type": "object",
      "required": ["id", "blueprint_path", "node_hash", "certificate_hash"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.schema.json#/definitions/moduleId"},
        "blueprint_path": {"$ref": "common.schema.json#/definitions/relativePath"},
        "node_hash": {"$ref": "certificate.schema.json#/definitions/sha256"},
        "certificate_hash": {"$ref": "certificate.schema.json#/definitions/sha256"}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/node"}
    }
  },
  "definitions": {
    "certificateState": {
      "type": "object",
      "required": ["status", "node_hash", "certificate_hash"],
      "additionalProperties": false,
      "properties": {
        "status": {"const": "current"},
        "node_hash": {"$ref": "certificate.schema.json#/definitions/sha256"},
        "certificate_hash": {"$ref": "certificate.schema.json#/definitions/sha256"}
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "node_type", "version", "blueprint_path", "gateway_path", "declaration", "certificate"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "node_type": {"enum": ["module", "behavioral_source"]},
        "version": {"$ref": "common.schema.json#/definitions/interfaceVersion"},
        "blueprint_path": {"$ref": "common.schema.json#/definitions/relativePath"},
        "gateway_path": {"$ref": "common.schema.json#/definitions/relativePath"},
        "declaration": {"type": "object"},
        "certificate": {"$ref": "#/definitions/certificateState"}
      }
    }
  },
  "x-famulus": {
    "authority": "generated-review-only",
    "graph_input": false,
    "health_authority": false,
    "canonical_source": "version 4 graph plus current node certificates"
  }
}
