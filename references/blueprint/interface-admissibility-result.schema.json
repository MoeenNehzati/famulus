{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "interface-admissibility-result.schema.json",
  "title": "Interface Admissibility Diagnostic Result",
  "type": "object",
  "required": ["schema_version", "subject", "source_hash", "profile", "profile_hash", "rule", "result", "findings", "evidence"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "subject": {"type": "string", "minLength": 1},
    "source_hash": {"$ref": "#/definitions/digest"},
    "profile": {"$ref": "#/definitions/versionedId"},
    "profile_hash": {"$ref": "#/definitions/digest"},
    "rule": {"$ref": "#/definitions/versionedId"},
    "result": {"enum": ["passed", "failed", "not-applicable", "checker-error"]},
    "findings": {"type": "array", "items": {"$ref": "#/definitions/finding"}},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "definitions": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "versionedId": {"type": "object", "required": ["id", "version"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}}},
    "finding": {"type": "object", "required": ["code", "location", "message"], "additionalProperties": false, "properties": {"code": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}, "location": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}}
  },
  "allOf": [
    {"if": {"properties": {"result": {"enum": ["passed", "not-applicable"]}}}, "then": {"properties": {"findings": {"maxItems": 0}}}},
    {"if": {"properties": {"result": {"enum": ["failed", "checker-error"]}}}, "then": {"properties": {"findings": {"minItems": 1}}}}
  ]
}
