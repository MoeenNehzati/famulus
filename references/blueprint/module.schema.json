{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "module.schema.json",
  "title": "Module Blueprint",
  "description": "Closed version 4 contract for one module ownership, authority, discovery, containment, and export boundary.",
  "type": "object",
  "required": ["schema_version", "node_type", "id", "version", "gateway", "content", "authority", "sources", "exports"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 4,
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": 4}, "doc": {"authoring": ["Use unified blueprint schema version 4."]}, "related_validation_rules": ["schema-shape"]}
    },
    "node_type": {
      "const": "module",
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": "module"}, "doc": {"authoring": ["Identify this root as a module boundary."]}, "related_validation_rules": ["schema-shape"]}
    },
    "id": {
      "$ref": "common.schema.json#/definitions/moduleId",
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": "example-skill"}, "doc": {"authoring": ["Use the globally unique module ID."]}, "related_validation_rules": ["canonical-id", "root-directory-id"]}
    },
    "version": {
      "$ref": "common.schema.json#/definitions/interfaceVersion",
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": 1}, "doc": {"authoring": ["Increment when the module boundary contract changes."]}, "related_validation_rules": ["version-pin"]}
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "x-famulus": {"field_status": "optional", "audit_hash": "include", "template": {"include": true, "example": "Provides an example skill."}, "doc": {"authoring": ["Describe the module's external role; certification requires this field."]}, "related_validation_rules": ["schema-shape"]}
    },
    "category": {
      "$ref": "legacy-skill.schema.json#/properties/category",
      "x-famulus": {"field_status": "optional", "audit_hash": "include", "template": {"include": true, "example": "development-assistant"}, "doc": {"authoring": ["For discoverable skills, preserve the existing taxonomy category."]}, "related_validation_rules": ["schema-shape"]}
    },
    "role": {
      "$ref": "legacy-skill.schema.json#/definitions/skillRole",
      "x-famulus": {"field_status": "optional", "audit_hash": "include", "template": {"include": true, "example": "automation"}, "doc": {"authoring": ["For discoverable skills, preserve the existing operating role."]}, "related_validation_rules": ["schema-shape"]}
    },
    "kind": {
      "$ref": "legacy-skill.schema.json#/definitions/skillKind",
      "x-famulus": {"field_status": "optional", "audit_hash": "include", "template": {"include": true, "example": "tool"}, "doc": {"authoring": ["For discoverable skills, preserve the existing implementation kind."]}, "related_validation_rules": ["schema-shape"]}
    },
    "gateway": {
      "$ref": "common.schema.json#/definitions/gateway",
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": {"path": "SKILL.md", "language": "Markdown"}}, "doc": {"authoring": ["Name the module's whole-file operational gateway."]}, "related_validation_rules": ["gateway-file", "content-files"]}
    },
    "content": {
      "$ref": "common.schema.json#/definitions/contentPatterns",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": ["SKILL\\.md"]}, "doc": {"authoring": ["Match the module's containment scope; direct ownership is resolved against contained sources. The project node-input policy selects hash inputs from that ownership scope."]}, "related_validation_rules": ["content-files", "content-exclusive"]}
    },
    "discovery": {
      "$ref": "#/definitions/discovery",
      "description": "Optional discovery convention. Absence means the module is found only through an explicit dependency.",
      "x-famulus": {"field_status": "optional", "audit_hash": "include", "template": {"include": true, "example": {"mechanism": "skill"}}, "doc": {"authoring": ["Use the verified skill mechanism only for host-discoverable skill modules; omit for dependency-only modules."]}, "related_validation_rules": ["schema-shape"]}
    },
    "authority": {
      "$ref": "#/definitions/authority",
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": {"owns_filesystem": []}}, "doc": {"authoring": ["Declare module-level filesystem authority and optional host permission suggestions."]}, "related_validation_rules": ["filesystem-ownership"]}
    },
    "sources": {
      "type": "object",
      "propertyNames": {"$ref": "common.schema.json#/definitions/behavioralSourceId"},
      "additionalProperties": {"$ref": "common.schema.json#/definitions/sourceContainment"},
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": {}}, "doc": {"authoring": ["Contain behavioral sources by canonical ID and blueprint only; source versions remain source-owned."]}, "related_validation_rules": ["relationship-edge"]}
    },
    "exports": {
      "type": "object",
      "propertyNames": {"$ref": "common.schema.json#/definitions/exportInterfaceId"},
      "additionalProperties": {"$ref": "#/definitions/export"},
      "x-famulus": {"field_status": "required", "audit_hash": "include", "template": {"include": true, "example": {}}, "doc": {"authoring": ["Expose source interfaces by canonical export ID without duplicating their versions or contracts."]}, "related_validation_rules": ["canonical-id", "relationship-edge", "access-control"]}
    }
  },
  "definitions": {
    "discovery": {
      "type": "object",
      "required": ["mechanism"],
      "additionalProperties": false,
      "properties": {"mechanism": {"const": "skill"}}
    },
    "authority": {
      "type": "object",
      "required": ["owns_filesystem"],
      "additionalProperties": false,
      "properties": {
        "owns_filesystem": {"$ref": "common.schema.json#/definitions/v4FilesystemOwnershipList"},
        "suggested_permissions": {"$ref": "legacy-skill.schema.json#/properties/suggested_permissions"}
      }
    },
    "access": {
      "type": "object",
      "required": ["allow_all_modules", "allowed_callers"],
      "additionalProperties": false,
      "properties": {
        "allow_all_modules": {"type": "boolean"},
        "allowed_callers": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/definitions/moduleId"}}
      },
      "allOf": [
        {"if": {"properties": {"allow_all_modules": {"const": true}}}, "then": {"properties": {"allowed_callers": {"maxItems": 0}}}}
      ]
    },
    "export": {
      "type": "object",
      "required": ["source_interface", "access"],
      "additionalProperties": false,
      "properties": {
        "source_interface": {"$ref": "common.schema.json#/definitions/sourceInterfaceId"},
        "access": {"$ref": "#/definitions/access"}
      }
    }
  },
  "x-famulus": {
    "audit_hash": "include",
    "gateway_policy": "whole-file",
    "export_version": "derived-from-source-interface"
  }
}
