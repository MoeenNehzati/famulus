{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "interface-projection.schema.json",
  "title": "Consumer-Local Interface Projection",
  "type": "object",
  "required": ["schema_version", "consumer", "interfaces", "helper_interfaces", "definitions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 2},
    "consumer": {"$ref": "common.schema.json#/definitions/behavioralSourceId"},
    "interfaces": {"type": "object", "additionalProperties": {"$ref": "#/definitions/resolvedInterface"}},
    "helper_interfaces": {"type": "object", "additionalProperties": {"$ref": "#/definitions/resolvedInterface"}},
    "definitions": {"type": "object", "additionalProperties": {"$ref": "#/definitions/embeddedDefinition"}}
  },
  "definitions": {
    "resolvedInterface": {
      "type": "object",
      "required": ["id", "version", "description", "source_module", "source_interface", "gateway", "contract"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.schema.json#/definitions/interfaceId"},
        "version": {"$ref": "common.schema.json#/definitions/interfaceVersion"},
        "description": {"type": "string", "minLength": 1},
        "source_module": {"$ref": "common.schema.json#/definitions/moduleId"},
        "source_interface": {"$ref": "common.schema.json#/definitions/sourceInterfaceId"},
        "gateway": {"$ref": "common.schema.json#/definitions/gateway"},
        "contract": {"$ref": "caller-contract.schema.json#/definitions/v4Contract"},
        "process_binding": {"$ref": "caller-contract.schema.json#/definitions/v4ProcessBinding"}
      }
    },
    "embeddedDefinition": {
      "type": "object",
      "required": ["source_module", "path", "fragment", "digest", "value"],
      "additionalProperties": false,
      "properties": {
        "source_module": {"$ref": "common.schema.json#/definitions/moduleId"},
        "path": {"$ref": "common.schema.json#/definitions/relativePath"},
        "fragment": {"type": "string", "pattern": "^#"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "value": {}
      }
    }
  }
}
