{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "interface-projection.schema.json",
  "title": "Consumer-Local Interface Projection",
  "oneOf": [
    {"$ref": "#/definitions/legacyProjection"},
    {"$ref": "#/definitions/v4Projection"}
  ],
  "definitions": {
    "legacyProjection": {
      "type": "object",
      "required": ["schema_version", "consumer", "interfaces", "helper_interfaces", "llm_interfaces", "definitions"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "consumer": {"type": "string", "minLength": 1},
        "interfaces": {"type": "object", "additionalProperties": {"$ref": "#/definitions/legacyMachineInterface"}},
        "helper_interfaces": {"type": "object", "additionalProperties": {"$ref": "#/definitions/legacyMachineInterface"}},
        "llm_interfaces": {"type": "object", "additionalProperties": {"$ref": "#/definitions/legacyLlmInterface"}},
        "definitions": {"type": "object", "additionalProperties": {"$ref": "#/definitions/legacyEmbeddedDefinition"}}
      }
    },
    "v4Projection": {
      "type": "object",
      "required": ["schema_version", "consumer", "interfaces", "helper_interfaces", "definitions"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 2},
        "consumer": {"$ref": "common.schema.json#/definitions/behavioralSourceId"},
        "interfaces": {"type": "object", "additionalProperties": {"$ref": "#/definitions/v4Interface"}},
        "helper_interfaces": {"type": "object", "additionalProperties": {"$ref": "#/definitions/v4Interface"}},
        "definitions": {"type": "object", "additionalProperties": {"$ref": "#/definitions/v4EmbeddedDefinition"}}
      }
    },
    "legacyMachineInterface": {
      "type": "object",
      "required": ["id", "version", "description", "invocation_binding", "direct_io", "helpers", "contract"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "\\.machine\\."},
        "version": {"type": "integer", "minimum": 1},
        "description": {"type": "string", "minLength": 1},
        "invocation_binding": {"type": "object"},
        "direct_io": {"type": "object"},
        "helpers": {"type": "array"},
        "contract": {"type": "object"}
      }
    },
    "legacyLlmInterface": {
      "type": "object",
      "required": ["id", "version", "description"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "\\.llm\\."},
        "version": {"type": "integer", "minimum": 1},
        "description": {"type": "string", "minLength": 1},
        "gateway": {"type": "string", "minLength": 1},
        "route": {
          "type": "object",
          "required": ["kind", "skill"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "provider-skill"},
            "skill": {"type": "string", "minLength": 1}
          }
        }
      },
      "oneOf": [{"required": ["gateway"]}, {"required": ["route"]}]
    },
    "legacyEmbeddedDefinition": {
      "type": "object",
      "required": ["source_skill", "path", "fragment", "digest", "value"],
      "additionalProperties": false,
      "properties": {
        "source_skill": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "fragment": {"type": "string", "pattern": "^#"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "value": {}
      }
    },
    "v4Interface": {
      "type": "object",
      "required": ["id", "version", "description", "source_module", "source_interface", "gateway", "contract"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.schema.json#/definitions/interfaceId"},
        "version": {"$ref": "common.schema.json#/definitions/interfaceVersion"},
        "description": {"type": "string", "minLength": 1},
        "source_module": {"$ref": "common.schema.json#/definitions/moduleId"},
        "source_interface": {"$ref": "common.schema.json#/definitions/sourceInterfaceId"},
        "gateway": {"$ref": "common.schema.json#/definitions/gateway"},
        "contract": {"$ref": "caller-contract.schema.json#/definitions/v4Contract"},
        "process_binding": {"$ref": "caller-contract.schema.json#/definitions/v4ProcessBinding"}
      }
    },
    "v4EmbeddedDefinition": {
      "type": "object",
      "required": ["source_module", "path", "fragment", "digest", "value"],
      "additionalProperties": false,
      "properties": {
        "source_module": {"$ref": "common.schema.json#/definitions/moduleId"},
        "path": {"$ref": "common.schema.json#/definitions/relativePath"},
        "fragment": {"type": "string", "pattern": "^#"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "value": {}
      }
    }
  }
}
