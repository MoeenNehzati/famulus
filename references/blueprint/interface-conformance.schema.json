{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "interface-conformance.schema.json",
  "title": "Machine Module Interface Conformance Manifest",
  "type": "object",
  "required": ["schema_version", "module", "execution_boundary", "adapters", "exports"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "module": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+\\.machine-module\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "execution_boundary": {"$ref": "#/definitions/executionBoundary"},
    "adapters": {"$ref": "#/definitions/adapters"},
    "exports": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/definitions/exportCases"}}
  },
  "definitions": {
    "localId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "executionBoundary": {
      "type": "object",
      "required": ["kind", "sandbox_backends"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "python-adapter-v1"},
        "sandbox_backends": {
          "type": "object",
          "required": ["linux", "macos", "windows"],
          "additionalProperties": false,
          "properties": {
            "linux": {"const": "linux-bwrap-v1"},
            "macos": {"const": "macos-seatbelt-v1"},
            "windows": {"const": "windows-appcontainer-v1"}
          }
        }
      }
    },
    "adapters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "filesystem": {"type": "string", "minLength": 1},
        "clock": {"type": "string", "minLength": 1},
        "network": {"type": "string", "minLength": 1},
        "helpers": {"type": "string", "minLength": 1},
        "subprocess": {"type": "string", "minLength": 1},
        "calendar": {"type": "string", "minLength": 1},
        "email": {"type": "string", "minLength": 1}
      }
    },
    "notInducible": {
      "type": "object",
      "required": ["kind", "reason"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "not-deterministically-inducible"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "fixtureState": {
      "type": "object",
      "required": ["files"],
      "additionalProperties": false,
      "properties": {
        "files": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "helperResult": {
      "type": "object",
      "required": ["outcome", "outputs"],
      "additionalProperties": false,
      "properties": {
        "outcome": {"$ref": "#/definitions/localId"},
        "outputs": {"type": "object"}
      }
    },
    "streamExpectation": {
      "oneOf": [
        {"type": "object", "required": ["empty"], "additionalProperties": false, "properties": {"empty": {"const": true}}},
        {"type": "object", "required": ["framing", "schema"], "additionalProperties": false, "properties": {"framing": {"enum": ["raw", "text", "exactly-one-json-document", "newline-delimited-json"]}, "schema": {"type": "string", "minLength": 1}, "first_event_kind": {"type": "string", "minLength": 1}}}
      ]
    },
    "effectExpectation": {
      "type": "object",
      "required": ["direct_io_ref", "action"],
      "additionalProperties": false,
      "properties": {
        "direct_io_ref": {"$ref": "#/definitions/localId"},
        "action": {"enum": ["create", "update", "append", "delete", "send", "execute", "configure"]},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "exportCases": {
      "type": "object",
      "required": ["cases"],
      "additionalProperties": false,
      "properties": {
        "outcome_coverage": {"type": "object", "additionalProperties": {"$ref": "#/definitions/notInducible"}},
        "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/case"}}
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "caller_argv", "stdin_requested", "timeout_seconds"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/definitions/localId"},
        "caller_argv": {"type": "array", "items": {"type": "string"}},
        "stdin_requested": {"type": "boolean"},
        "stdin": {"type": "string"},
        "fixture_state": {"$ref": "#/definitions/fixtureState"},
        "helper_results": {"type": "object", "additionalProperties": {"$ref": "#/definitions/helperResult"}},
        "expected_parser_result": {"const": "rejected"},
        "expected_diagnostic": {"type": "string", "minLength": 1},
        "expected_outcome": {"$ref": "#/definitions/localId"},
        "expected_streams": {"type": "object", "minProperties": 1, "additionalProperties": false, "properties": {"stdout": {"$ref": "#/definitions/streamExpectation"}, "stderr": {"$ref": "#/definitions/streamExpectation"}, "event-stream": {"$ref": "#/definitions/streamExpectation"}, "file": {"$ref": "#/definitions/streamExpectation"}}},
        "expected_effects": {"type": "array", "items": {"$ref": "#/definitions/effectExpectation"}},
        "observation_scope": {"type": "object", "required": ["kind", "boundaries"], "additionalProperties": false, "properties": {"kind": {"const": "sandbox"}, "boundaries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["filesystem", "clock", "network", "helper", "subprocess", "calendar", "email", "process", "stdout", "stderr"]}}}},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "readiness_deadline_seconds": {"type": "integer", "minimum": 1},
        "stop": {"oneOf": [{"type": "object", "required": ["kind"], "additionalProperties": false, "properties": {"kind": {"const": "dispatcher-cancel"}}}, {"type": "object", "required": ["kind", "signal"], "additionalProperties": false, "properties": {"kind": {"const": "signal"}, "signal": {"type": "string", "minLength": 1}}}, {"type": "object", "required": ["kind", "helper_ref"], "additionalProperties": false, "properties": {"kind": {"const": "helper"}, "helper_ref": {"$ref": "#/definitions/localId"}}}]},
        "stop_deadline_seconds": {"type": "integer", "minimum": 1},
        "cleanup": {"type": "object", "required": ["kind"], "additionalProperties": false, "properties": {"kind": {"const": "terminate-and-remove-fixtures"}}},
        "post_cleanup_assertions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kind"], "additionalProperties": false, "properties": {"kind": {"enum": ["process-exited", "fixture-root-removed"]}}}}
      },
      "oneOf": [
        {"required": ["expected_parser_result", "expected_diagnostic"]},
        {"required": ["expected_outcome", "expected_effects", "observation_scope"]}
      ],
      "allOf": [
        {"if": {"required": ["readiness_deadline_seconds"]}, "then": {"required": ["stop", "stop_deadline_seconds", "cleanup", "post_cleanup_assertions"]}},
        {"if": {"required": ["stop"]}, "then": {"required": ["readiness_deadline_seconds", "stop_deadline_seconds", "cleanup", "post_cleanup_assertions"]}}
      ]
    }
  }
}
