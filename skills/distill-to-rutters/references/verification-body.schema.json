{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification-body.schema.json",
  "title": "Verification Evidence Contract Body",
  "type": "object",
  "required": ["candidate_path", "candidate_sha256", "verification_evidence", "semantic_traces"],
  "additionalProperties": false,
  "properties": {
    "candidate_path": {"type": "string", "minLength": 1},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verification_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "result", "classification", "evidence"],
        "additionalProperties": false,
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "result": {"enum": ["passed", "failed", "blocked"]},
          "classification": {"enum": ["product", "environment"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "semantic_traces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["obligation_id", "positive_result", "negative_result"],
        "additionalProperties": false,
        "properties": {
          "obligation_id": {"type": "string", "minLength": 1},
          "positive_result": {"type": "string", "minLength": 1},
          "negative_result": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
