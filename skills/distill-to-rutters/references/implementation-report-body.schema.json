{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "implementation-report-body.schema.json",
  "title": "Implementation Trace Contract Body",
  "type": "object",
  "required": ["implementation_trace_map", "changed_files", "limitations"],
  "additionalProperties": false,
  "properties": {
    "implementation_trace_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["obligation_id", "design_item", "implemented_symbol", "path", "evidence", "status"],
        "additionalProperties": false,
        "properties": {
          "obligation_id": {"type": "string", "minLength": 1},
          "design_item": {"type": "string", "minLength": 1},
          "implemented_symbol": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "status": {"enum": ["implemented", "gap", "blocked", "partial", "failed"]}
        }
      }
    },
    "changed_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
