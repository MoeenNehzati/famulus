{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "kind",
    "instruction_interface",
    "owner_node_id",
    "target_id",
    "reviewed_repository",
    "reviewed_commit",
    "audited_input_identity",
    "input_manifest",
    "selected_content",
    "prerequisite_reports",
    "prerequisite_certificates",
    "prerequisite_declarations"
  ],
  "properties": {
    "prerequisite_declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "blueprint_path", "declaration"],
        "properties": {
          "target_id": {"type": "string", "minLength": 1},
          "blueprint_path": {"type": "string", "minLength": 1},
          "declaration": {"type": "object"}
        }
      }
    },
    "schema_version": {
      "const": "skill-certifier.semantic-audit-task/v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "audit-interface",
        "audit-behavioral-source",
        "audit-module"
      ]
    },
    "instruction_interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "owner_node_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_repository": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_commit": {
      "type": "string",
      "minLength": 1
    },
    "audited_input_identity": {
      "type": "string",
      "minLength": 1
    },
    "input_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "digest",
          "git_provenance"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "minLength": 1
          },
          "git_provenance": {
            "type": "string"
          }
        }
      }
    },
    "selected_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blueprint_path",
        "declaration",
        "gateway"
      ],
      "properties": {
        "blueprint_path": {
          "type": "string",
          "minLength": 1
        },
        "declaration": {
          "type": "object"
        },
        "gateway": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "prerequisite_reports": {
      "type": "array",
      "items": {
        "$ref": "semantic-audit-result.schema.json"
      }
    },
    "prerequisite_certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "owner_node_id",
          "certificate_identity",
          "certificate_path",
          "subject",
          "facets",
          "dependencies",
          "input_manifest",
          "checks"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "owner_node_id": {
            "type": "string",
            "minLength": 1
          },
          "certificate_identity": {
            "type": "string",
            "minLength": 1
          },
          "certificate_path": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "object"
          },
          "facets": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "input_manifest": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "digest",
                "git_provenance"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "minLength": 1
                },
                "git_provenance": {
                  "type": "string"
                }
              }
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
