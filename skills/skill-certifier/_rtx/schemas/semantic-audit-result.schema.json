{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nullkit.dev/schemas/skill-certifier-semantic-audit-result-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "verdict", "summary", "evidence", "consumed_dependencies", "findings"],
  "properties": {
    "schema_version": {"const": "skill-certifier.semantic-audit-result/v1"},
    "task_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["pass", "reject", "abort"]},
    "summary": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "consumed_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "verdict"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "verdict": {"const": "pass"}
        }
      }
    },
    "findings": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "pass"}}},
      "then": {"properties": {"findings": {"maxItems": 0}}},
      "else": {"properties": {"findings": {"minItems": 1}}}
    }
  ]
}
