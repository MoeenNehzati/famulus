#!/usr/bin/env python3
"""Launcher for the 'background_run' agent -- the scheduler's agent.

This is what invoke-skill runs, so every scheduled job goes through it rather
than through 'assistant'. Being a separate agent is the whole point: it gets
its own instructions (agents/background_run.md), its own Codex profile, and
its own Claude settings, so an unattended run's model, reasoning budget, and
hooks are configured for unattended work instead of inherited from whatever
the interactive assistant is tuned for.

Backend priority: $BACKGROUND_RUN_DEFAULT > $ASSISTANT_DEFAULT > 'claude'.
See bin/assistant for notes on adding new agents.
"""
import os, sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _agent_launch

_agent_launch.launch(
    agent="background_run",
    default_backend=os.environ.get(
        "BACKGROUND_RUN_DEFAULT", os.environ.get("ASSISTANT_DEFAULT", "claude")
    ),
    args=sys.argv[1:],
)
