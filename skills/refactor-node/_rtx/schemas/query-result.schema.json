{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "query-result.schema.json",
  "title": "Refactor Node Standards Query Result",
  "type": "object",
  "required": ["repository_root", "target", "view", "partitions", "standards"],
  "additionalProperties": false,
  "properties": {
    "repository_root": {"type": "string"},
    "target": {"type": "string", "minLength": 1},
    "view": {"enum": ["requirements", "context", "evidence", "remedies", "full", "query"]},
    "partitions": {"type": "array", "items": {"$ref": "#/definitions/partition"}},
    "standards": {"type": "object"},
    "available_views": {
      "type": "array",
      "items": {"enum": ["requirements", "context", "evidence", "remedies", "full"]},
      "uniqueItems": true
    },
    "documents": {
      "type": "object",
      "additionalProperties": {"$ref": "#/definitions/document"}
    },
    "catalog": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"view": {"const": "requirements"}}},
      "then": {
        "required": ["available_views", "documents", "catalog"],
        "properties": {
          "catalog": {"$ref": "#/definitions/requirementsCatalog"},
          "standards": {"type": "object", "additionalProperties": {"$ref": "#/definitions/requirementsStandard"}}
        }
      }
    },
    {
      "if": {"properties": {"view": {"const": "context"}}},
      "then": {
        "required": ["available_views", "documents", "catalog"],
        "properties": {
          "catalog": {"$ref": "#/definitions/contextCatalog"},
          "standards": {"type": "object", "additionalProperties": {"$ref": "#/definitions/contextStandard"}}
        }
      }
    },
    {
      "if": {"properties": {"view": {"const": "evidence"}}},
      "then": {
        "required": ["available_views", "documents", "catalog"],
        "properties": {
          "catalog": {"$ref": "#/definitions/evidenceCatalog"},
          "standards": {"type": "object", "additionalProperties": {"$ref": "#/definitions/evidenceStandard"}}
        }
      }
    },
    {
      "if": {"properties": {"view": {"const": "remedies"}}},
      "then": {
        "required": ["available_views", "documents", "catalog"],
        "properties": {
          "catalog": {"$ref": "#/definitions/remediesCatalog"},
          "standards": {"type": "object", "additionalProperties": {"$ref": "#/definitions/remediesStandard"}}
        }
      }
    },
    {
      "if": {"properties": {"view": {"enum": ["full", "query"]}}},
      "then": {
        "properties": {
          "standards": {"type": "object", "additionalProperties": {"$ref": "#/definitions/looseStandard"}}
        },
        "not": {"anyOf": [{"required": ["catalog"]}, {"required": ["documents"]}, {"required": ["available_views"]}]}
      }
    }
  ],
  "definitions": {
    "partition": {
      "type": "object",
      "required": ["owner"],
      "additionalProperties": false,
      "properties": {
        "owner": {"type": "object"},
        "standard_ref": {"type": "string"},
        "unsupported": {"type": "object"}
      },
      "oneOf": [{"required": ["standard_ref"]}, {"required": ["unsupported"]}]
    },
    "document": {
      "type": "object",
      "required": ["path", "digest"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "standardBase": {
      "type": "object",
      "required": ["leaf", "facts", "documents"],
      "properties": {
        "leaf": {"type": "string", "minLength": 1},
        "facts": {"type": "object"},
        "documents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "stateOverlay": {
      "type": "object",
      "required": ["true", "unknown"],
      "additionalProperties": false,
      "properties": {
        "true": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
        "unknown": {"type": "array", "items": {"$ref": "#/definitions/unknownIndex"}}
      }
    },
    "unknownIndex": {
      "type": "object",
      "required": ["index", "missing_facts"],
      "additionalProperties": false,
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "missing_facts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "requirement": {
      "type": "object",
      "required": ["document", "ref", "modality", "statement"],
      "additionalProperties": false,
      "properties": {
        "document": {"type": "string"},
        "ref": {"type": "string"},
        "modality": {"type": "string"},
        "statement": {"type": "string"}
      }
    },
    "contextIndex": {
      "type": "object",
      "required": ["document", "ref", "title"],
      "additionalProperties": false,
      "properties": {
        "document": {"type": "string"},
        "ref": {"type": "string"},
        "title": {"type": "string"},
        "summary": {"type": "string"}
      }
    },
    "context": {
      "type": "object",
      "required": ["document", "ref", "kind"],
      "additionalProperties": false,
      "properties": {
        "document": {"type": "string"},
        "ref": {"type": "string"},
        "kind": {"type": "string"},
        "content": {"type": "object"}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["document", "ref", "section", "content"],
      "additionalProperties": false,
      "properties": {
        "document": {"type": "string"},
        "ref": {"type": "string"},
        "section": {"type": "string"},
        "content": {"type": "object"}
      }
    },
    "catalogRecord": {
      "type": "object",
      "required": ["document", "ref", "content"],
      "additionalProperties": false,
      "properties": {
        "document": {"type": "string"},
        "ref": {"type": "string"},
        "content": {"type": "object"}
      }
    },
    "remedy": {
      "type": "object",
      "required": ["document", "ref", "source", "target"],
      "additionalProperties": false,
      "properties": {
        "document": {"type": "string"},
        "ref": {"type": "string"},
        "source": {"type": "object"},
        "target": {"type": "object"}
      }
    },
    "requirementsCatalog": {
      "type": "object",
      "required": ["requirements", "context_index"],
      "additionalProperties": false,
      "properties": {
        "requirements": {"type": "array", "items": {"$ref": "#/definitions/requirement"}},
        "context_index": {"type": "array", "items": {"$ref": "#/definitions/contextIndex"}}
      }
    },
    "contextCatalog": {
      "type": "object",
      "required": ["context"],
      "additionalProperties": false,
      "properties": {"context": {"type": "array", "items": {"$ref": "#/definitions/context"}}}
    },
    "evidenceCatalog": {
      "type": "object",
      "required": ["evidence", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "evidence": {"type": "array", "items": {"$ref": "#/definitions/evidence"}},
        "artifacts": {"type": "array", "items": {"$ref": "#/definitions/catalogRecord"}}
      }
    },
    "remediesCatalog": {
      "type": "object",
      "required": ["remedies", "procedures"],
      "additionalProperties": false,
      "properties": {
        "remedies": {"type": "array", "items": {"$ref": "#/definitions/remedy"}},
        "procedures": {"type": "array", "items": {"$ref": "#/definitions/catalogRecord"}}
      }
    },
    "requirementsStandard": {
      "allOf": [
        {"$ref": "#/definitions/standardBase"},
        {
          "type": "object",
          "required": ["requirements", "context_index"],
          "additionalProperties": false,
          "properties": {
            "leaf": {}, "facts": {}, "documents": {},
            "requirements": {"$ref": "#/definitions/stateOverlay"},
            "context_index": {"$ref": "#/definitions/stateOverlay"}
          }
        }
      ]
    },
    "contextStandard": {
      "allOf": [
        {"$ref": "#/definitions/standardBase"},
        {
          "type": "object",
          "required": ["context"],
          "additionalProperties": false,
          "properties": {"leaf": {}, "facts": {}, "documents": {}, "context": {"$ref": "#/definitions/stateOverlay"}}
        }
      ]
    },
    "evidenceStandard": {
      "allOf": [
        {"$ref": "#/definitions/standardBase"},
        {
          "type": "object",
          "required": ["evidence", "artifacts"],
          "additionalProperties": false,
          "properties": {
            "leaf": {}, "facts": {}, "documents": {},
            "evidence": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
            "artifacts": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true}
          }
        }
      ]
    },
    "remediesStandard": {
      "allOf": [
        {"$ref": "#/definitions/standardBase"},
        {
          "type": "object",
          "required": ["remedies", "procedures"],
          "additionalProperties": false,
          "properties": {
            "leaf": {}, "facts": {}, "documents": {},
            "remedies": {"$ref": "#/definitions/stateOverlay"},
            "procedures": {"$ref": "#/definitions/stateOverlay"}
          }
        }
      ]
    },
    "looseStandard": {
      "type": "object",
      "required": ["leaf", "view", "facts", "documents"],
      "additionalProperties": true,
      "properties": {
        "leaf": {"type": "string"},
        "view": {"enum": ["full", "query"]},
        "facts": {"type": "object"},
        "documents": {"type": "array"}
      }
    }
  }
}
