{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "relocations"],
  "properties": {
    "schema_version": {"const": 3},
    "relocations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rename"}
    },
    "python_modules": {
      "type": "array",
      "items": {"$ref": "#/$defs/rename"}
    },
    "inventory_exclusions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "semantic_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["occurrence_id", "disposition"],
        "properties": {
          "occurrence_id": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["rewrite", "preserve"]},
          "replacement": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "rename": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1}
      }
    }
  }
}
