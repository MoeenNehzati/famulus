{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://officina.local/math-dependency-graph/proof-normalization.schema.json",
  "title": "Proof normalization decisions and provenance report",
  "description": "Strict deterministic handoff between proof reconciliation and proof-free semantic IR.",
  "oneOf": [
    {"$ref": "#/$defs/decisions_document"},
    {"$ref": "#/$defs/report_document"}
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_ir_sha256", "inventory_sha256", "source_sha256", "packet_payload_sha256"],
      "properties": {
        "semantic_ir_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "packet_payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "qualified_evidence_id": {"type": "string", "pattern": "^[^:]+::e[1-9][0-9]*$"},
    "qualified_hint_id": {"type": "string", "pattern": "^[^:]+::h[1-9][0-9]*$"},
    "qualified_reference_id": {"type": "string", "pattern": "^[^:]+::r[1-9][0-9]*$"},
    "proof_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_ids", "id", "type", "kind", "statement_location", "short_title", "description", "source"],
      "properties": {
        "candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "id": {"$ref": "#/$defs/identifier"},
        "type": {"const": "proof"},
        "kind": {"enum": ["formal", "informal", "sketch"]},
        "category_label": {"type": "string", "minLength": 1},
        "statement_location": {
          "type": "array",
          "description": "Compact [file_index, start_line, end_line] span of the complete proof passage.",
          "prefixItems": [
            {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "short_title": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "source": {"enum": ["explicit", "inferred"]},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "compiler_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removed_proof_candidate_ids",
        "removed_proof_hint_ids",
        "removed_proof_reference_ids",
        "projected_candidate_ids"
      ],
      "properties": {
        "removed_proof_candidate_ids": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}
        },
        "removed_proof_hint_ids": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/qualified_hint_id"}
        },
        "removed_proof_reference_ids": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/qualified_reference_id"}
        },
        "projected_candidate_ids": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_id", "disposition", "reason"],
      "properties": {
        "proof_id": {"$ref": "#/$defs/identifier"},
        "disposition": {"enum": ["accepted", "excluded"]},
        "bundle_id": {"$ref": "#/$defs/identifier"},
        "target_id": {"$ref": "#/$defs/identifier"},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "accepted"}}, "required": ["disposition"]},
          "then": {"required": ["bundle_id", "target_id"]},
          "else": {"not": {"anyOf": [{"required": ["bundle_id"]}, {"required": ["target_id"]}]}}
        }
      ]
    },
    "decisions_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_kind", "ir_version", "input_identity", "decisions"],
      "properties": {
        "document_kind": {"const": "proof-normalization-decisions"},
        "ir_version": {"const": 1},
        "input_identity": {"$ref": "#/$defs/input_identity"},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}
      }
    },
    "relationship_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "description", "hint_ids", "evidence_ids", "implicit"],
      "properties": {
        "from": {"$ref": "#/$defs/identifier"},
        "to": {"$ref": "#/$defs/identifier"},
        "type": {"enum": ["supports", "illustrated-by", "proves"]},
        "description": {"type": "string", "minLength": 1},
        "hint_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/qualified_hint_id"}},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/qualified_evidence_id"}},
        "reference_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/qualified_reference_id"}},
        "implicit": {"type": "boolean"},
        "confidence": {"enum": ["Verified", "High", "Medium", "Low", "Likely", "Unknown"]}
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "target_id", "proof_ids", "proves_relationships"],
      "properties": {
        "bundle_id": {"$ref": "#/$defs/identifier"},
        "target_id": {"$ref": "#/$defs/identifier"},
        "proof_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "proves_relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship_snapshot"}}
      }
    },
    "relationship_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "proof_ids", "bundle_ids", "source_relationships"],
      "properties": {
        "from": {"$ref": "#/$defs/identifier"},
        "to": {"$ref": "#/$defs/identifier"},
        "type": {"enum": ["supports", "illustrated-by"]},
        "proof_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "bundle_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "source_relationships": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relationship_route"}}
      }
    },
    "relationship_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship"],
      "properties": {
        "relationship": {"$ref": "#/$defs/relationship_snapshot"},
        "proof_id": {"$ref": "#/$defs/identifier"},
        "bundle_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_id", "reason", "incident_relationships"],
      "properties": {
        "proof_id": {"$ref": "#/$defs/identifier"},
        "reason": {"type": "string", "minLength": 1},
        "incident_relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship_snapshot"}}
      }
    },
    "report_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_kind", "ir_version", "proof_entities", "bundles", "relationships", "exclusions"],
      "properties": {
        "document_kind": {"const": "proof-normalization-report"},
        "ir_version": {"const": 1},
        "proof_entities": {"type": "array", "items": {"$ref": "#/$defs/proof_entity"}},
        "compiler_inventory": {"$ref": "#/$defs/compiler_inventory"},
        "bundles": {"type": "array", "items": {"$ref": "#/$defs/bundle"}},
        "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship_report"}},
        "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}}
      }
    }
  }
}
