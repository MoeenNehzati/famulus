{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://officina.local/math-dependency-graph/semantic-repair.schema.json",
  "title": "Localized semantic graph correction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repair_version",
    "remove_entity_ids",
    "upsert_entities",
    "remove_exclusion_candidate_ids",
    "upsert_exclusions",
    "remove_unresolved_ids",
    "upsert_unresolved_resolutions",
    "remove_relationships",
    "upsert_relationships",
    "remove_hint_ids",
    "upsert_hint_decisions",
    "remove_reference_ids",
    "upsert_reference_decisions",
    "remove_gap_ids",
    "upsert_gaps",
    "remove_inventory_gap_ids",
    "upsert_gap_decisions"
  ],
  "properties": {
    "repair_version": {"const": 2},
    "remove_entity_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "upsert_entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "remove_exclusion_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "upsert_exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}},
    "remove_unresolved_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/unresolved_id"}},
    "upsert_unresolved_resolutions": {"type": "array", "items": {"$ref": "#/$defs/unresolved_resolution"}},
    "remove_relationships": {"type": "array", "items": {"$ref": "#/$defs/edge_key"}},
    "upsert_relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "remove_hint_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hint_id"}},
    "upsert_hint_decisions": {"type": "array", "items": {"$ref": "#/$defs/hint_decision"}},
    "remove_reference_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reference_id"}},
    "upsert_reference_decisions": {"type": "array", "items": {"$ref": "#/$defs/reference_decision"}},
    "remove_gap_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}},
    "upsert_gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "remove_inventory_gap_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/gap_id"}},
    "upsert_gap_decisions": {"type": "array", "items": {"$ref": "#/$defs/gap_decision"}}
  },
  "$defs": {
    "unresolved_id": {"type": "string", "pattern": "^[^:]+::u[1-9][0-9]*$"},
    "hint_id": {"type": "string", "pattern": "^[^:]+::h[1-9][0-9]*$"},
    "reference_id": {"type": "string", "pattern": "^[^:]+::r[1-9][0-9]*$"},
    "gap_id": {"type": "string", "pattern": "^[^:]+::g[1-9][0-9]*$"},
    "evidence_id": {"type": "string", "pattern": "^[^:]+::e[1-9][0-9]*$"},
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidence_id"}
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_ids", "id", "type", "short_title", "description", "source"],
      "properties": {
        "candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "type": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "category_label": {"type": "string", "minLength": 1},
        "short_title": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "source": {"enum": ["explicit", "inferred"]},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "reason"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "unresolved_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unresolved_id", "disposition"],
      "properties": {
        "unresolved_id": {"$ref": "#/$defs/unresolved_id"},
        "disposition": {"enum": ["matched", "created", "rejected", "unresolved"]},
        "entity_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"enum": ["matched", "created"]}}},
          "then": {"required": ["entity_id"]},
          "else": {
            "required": ["reason"],
            "not": {"required": ["entity_id"]}
          }
        }
      ]
    },
    "hint_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hint_id", "decision", "reason"],
      "properties": {
        "hint_id": {"$ref": "#/$defs/hint_id"},
        "decision": {"enum": ["rejected", "superseded", "unresolved"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "edge_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "type": {"enum": ["supports", "illustrated-by", "proves"]}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "description", "hint_ids", "evidence_ids", "implicit"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "type": {"enum": ["supports", "illustrated-by", "proves"]},
        "description": {"type": "string", "minLength": 1},
        "hint_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hint_id"}},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "reference_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reference_id"}},
        "implicit": {"type": "boolean"},
        "confidence": {"enum": ["Verified", "High", "Medium", "Low", "Likely", "Unknown"]}
      }
    },
    "reference_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "decision", "evidence_ids"],
      "properties": {
        "reference_id": {"$ref": "#/$defs/reference_id"},
        "decision": {"enum": ["self-reference", "navigation", "restatement", "contrast", "transitive", "excluded-source", "non-dependency", "other"]},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"enum": ["non-dependency", "other"]}}},
          "then": {"required": ["reason"]}
        }
      ]
    },
    "gap_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_id", "disposition", "reason"],
      "properties": {
        "gap_id": {"$ref": "#/$defs/gap_id"},
        "disposition": {"enum": ["resolved", "superseded", "rejected"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "evidence_ids", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "category": {"enum": ["identity", "scope", "evidence", "relationship", "reference", "coverage", "other"]},
        "reference_id": {"$ref": "#/$defs/reference_id"},
        "inventory_gap_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gap_id"}
        },
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "description": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"category": {"const": "reference"}}},
          "then": {"required": ["reference_id"]},
          "else": {"not": {"required": ["reference_id"]}}
        }
      ]
    }
  }
}
