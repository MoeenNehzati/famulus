{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://officina.local/math-dependency-graph/semantic-graph.schema.json",
  "title": "Whole-document resolved mathematical dependency graph",
  "description": "The sole extract worker reconciles every pooled candidate and qualified semantic handle. Deterministic validation resolves the handles before compilation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ir_version",
    "document",
    "inventory",
    "entities",
    "exclusions",
    "unresolved_resolutions",
    "relationships",
    "hint_decisions",
    "reference_decisions",
    "gap_decisions",
    "gaps"
  ],
  "properties": {
    "ir_version": {"const": 2},
    "document": {"$ref": "#/$defs/document"},
    "inventory": {"$ref": "#/$defs/inventory"},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}},
    "unresolved_resolutions": {
      "type": "array",
      "items": {"$ref": "#/$defs/unresolved_resolution"}
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    },
    "hint_decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/hint_decision"}
    },
    "reference_decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/reference_decision"}
    },
    "gap_decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/gap_decision"}
    },
    "edgeless_justification": {
      "description": "Source-grounded justification required when a multi-entity document genuinely has no direct dependencies.",
      "type": "string",
      "minLength": 1
    },
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
  },
  "$defs": {
    "qualified_evidence_id": {
      "type": "string",
      "pattern": "^[^:]+::e[1-9][0-9]*$"
    },
    "qualified_reference_id": {
      "type": "string",
      "pattern": "^[^:]+::r[1-9][0-9]*$"
    },
    "qualified_unresolved_id": {
      "type": "string",
      "pattern": "^[^:]+::u[1-9][0-9]*$"
    },
    "qualified_hint_id": {
      "type": "string",
      "pattern": "^[^:]+::h[1-9][0-9]*$"
    },
    "qualified_gap_id": {
      "type": "string",
      "pattern": "^[^:]+::g[1-9][0-9]*$"
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/qualified_evidence_id"}
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_file"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "source_file": {"type": "string", "minLength": 1}
      }
    },
    "inventory": {
      "type": "object",
      "description": "An exact ordered echo of the authoritative pooled candidate ids.",
      "additionalProperties": false,
      "required": ["candidate_ids", "candidate_count"],
      "properties": {
        "candidate_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "candidate_count": {"type": "integer", "minimum": 0}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_ids",
        "id",
        "type",
        "short_title",
        "description",
        "source"
      ],
      "properties": {
        "candidate_ids": {
          "description": "May be empty only for an entity targeted by a created unresolved resolution.",
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "type": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "category_label": {"type": "string", "minLength": 1},
        "short_title": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "source": {"enum": ["explicit", "inferred"]},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "reason"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "unresolved_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unresolved_id", "disposition"],
      "properties": {
        "unresolved_id": {"$ref": "#/$defs/qualified_unresolved_id"},
        "disposition": {"enum": ["matched", "created", "rejected", "unresolved"]},
        "entity_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"enum": ["matched", "created"]}}},
          "then": {"required": ["entity_id"]},
          "else": {
            "required": ["reason"],
            "not": {"required": ["entity_id"]}
          }
        }
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "type",
        "description",
        "hint_ids",
        "evidence_ids",
        "implicit"
      ],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "type": {"enum": ["supports", "illustrated-by"]},
        "description": {"type": "string", "minLength": 1},
        "hint_ids": {
          "description": "Accepted pooled relationship hints. Empty means the extract worker established a new direct edge from registered evidence.",
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/qualified_hint_id"}
        },
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/qualified_reference_id"}
        },
        "implicit": {"type": "boolean"},
        "confidence": {"enum": ["Verified", "High", "Medium", "Low", "Likely", "Unknown"]}
      }
    },
    "hint_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hint_id", "decision", "reason"],
      "properties": {
        "hint_id": {"$ref": "#/$defs/qualified_hint_id"},
        "decision": {"enum": ["rejected", "superseded", "unresolved"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "reference_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "decision", "evidence_ids"],
      "properties": {
        "reference_id": {"$ref": "#/$defs/qualified_reference_id"},
        "decision": {
          "enum": ["self-reference", "navigation", "restatement", "contrast", "transitive", "excluded-source", "non-dependency", "other"]
        },
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"enum": ["non-dependency", "other"]}}},
          "then": {"required": ["reason"]}
        }
      ]
    },
    "gap_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_id", "disposition", "reason"],
      "properties": {
        "gap_id": {"$ref": "#/$defs/qualified_gap_id"},
        "disposition": {"enum": ["resolved", "superseded", "rejected"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "evidence_ids", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "category": {
          "enum": ["identity", "scope", "evidence", "relationship", "reference", "coverage", "other"]
        },
        "reference_id": {"$ref": "#/$defs/qualified_reference_id"},
        "inventory_gap_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/qualified_gap_id"}
        },
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "description": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"category": {"const": "reference"}}},
          "then": {"required": ["reference_id"]},
          "else": {"not": {"required": ["reference_id"]}}
        }
      ]
    }
  }
}
