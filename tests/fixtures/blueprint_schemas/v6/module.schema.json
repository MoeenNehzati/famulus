{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "module.schema.json",
  "title": "Direct-Routing Module Blueprint",
  "description": "Closed version 6 contract for path-derived module identity, explicit child registration, namespace routing, and source-owned exports.",
  "type": "object",
  "required": [
    "schema_version",
    "node_type",
    "id",
    "version",
    "maturity",
    "gateway",
    "content",
    "authority",
    "sources",
    "children",
    "namespace_exports",
    "exports"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 6
    },
    "node_type": {
      "const": "module"
    },
    "id": {
      "$ref": "common.schema.json#/definitions/moduleId"
    },
    "version": {
      "$ref": "common.schema.json#/definitions/interfaceVersion"
    },
    "maturity": {
      "type": "string",
      "enum": ["stable", "experimental"]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "gateway": {
      "$ref": "common.schema.json#/definitions/gateway"
    },
    "content": {
      "$ref": "common.schema.json#/definitions/contentPatterns"
    },
    "discovery": {
      "$ref": "#/definitions/discovery"
    },
    "installation_tier": {
      "type": "string",
      "enum": ["core", "optional"]
    },
    "personal_preference": {
      "$ref": "#/definitions/personalPreference"
    },
    "authority": {
      "$ref": "#/definitions/authority"
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/definitions/behavioralSourceId"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/definitions/sourceContainment"
      }
    },
    "children": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/definitions/localModuleSegment"
      },
      "additionalProperties": {
        "type": "object",
        "maxProperties": 0
      }
    },
    "namespace_exports": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/definitions/localModuleSegment"
      },
      "additionalProperties": {
        "$ref": "#/definitions/namespaceExport"
      }
    },
    "exports": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/definitions/exportInterfaceId"
      },
      "additionalProperties": {
        "$ref": "#/definitions/sourceExport"
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["discovery"]},
      "then": {"required": ["installation_tier", "personal_preference"]}
    }
  ],
  "definitions": {
    "personalPreference": {
      "type": "object",
      "required": ["applies"],
      "additionalProperties": false,
      "properties": {
        "applies": {"type": "boolean"},
        "description": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"applies": {"const": true}}},
          "then": {"required": ["description"]}
        }
      ]
    },
    "authority": {
      "type": "object",
      "required": [
        "owns_filesystem"
      ],
      "additionalProperties": false,
      "properties": {
        "owns_filesystem": {
          "$ref": "common.schema.json#/definitions/v4FilesystemOwnershipList"
        },
        "suggested_permissions": {
          "$ref": "#/definitions/suggestedPermissions"
        }
      }
    },
    "access": {
      "type": "object",
      "required": [
        "allow_all_modules",
        "allowed_callers"
      ],
      "additionalProperties": false,
      "properties": {
        "allow_all_modules": {
          "type": "boolean"
        },
        "allowed_callers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/definitions/callerReference"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "allow_all_modules": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "allowed_callers": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "sourceExport": {
      "type": "object",
      "required": [
        "source_interface",
        "access"
      ],
      "additionalProperties": false,
      "properties": {
        "source_interface": {
          "$ref": "common.schema.json#/definitions/sourceInterfaceId"
        },
        "access": {
          "$ref": "#/definitions/access"
        },
        "setup_requires_setup_of": {
          "$ref": "common.schema.json#/definitions/interfaceUseList",
          "description": "Setup interfaces that must be completed before this setup interface.",
          "$comment": "Do not list the base Famulus or assistant-tools installer here. Famulus cannot start without it; that prerequisite is handled separately by a session-start hook."
        }
      }
    },
    "namespaceSurface": {
      "type": "object",
      "required": [
        "only"
      ],
      "additionalProperties": false,
      "properties": {
        "only": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "common.schema.json#/definitions/exportInterfaceId"
          },
          "additionalProperties": {
            "$ref": "common.schema.json#/definitions/interfaceVersion"
          }
        }
      }
    },
    "namespaceExport": {
      "type": "object",
      "required": [
        "version",
        "access",
        "surface"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "$ref": "common.schema.json#/definitions/interfaceVersion"
        },
        "access": {
          "$ref": "#/definitions/access"
        },
        "surface": {
          "$ref": "#/definitions/namespaceSurface"
        },
        "interface_access": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/definitions/exportInterfaceId"
          },
          "additionalProperties": {
            "$ref": "#/definitions/access"
          }
        }
      }
    },
    "catalogDomain": {
      "type": "string",
      "description": "The single configured documentation domain matching the module's primary direct user outcome.",
      "x-officina-config": {
        "operation": "values-to-enum",
        "source": "/blueprint_catalog/domains"
      }
    },
    "catalogTopic": {
      "type": "string",
      "description": "A configured cross-cutting subject directly served by the module, not merely used as an implementation dependency.",
      "x-officina-config": {
        "operation": "values-to-enum",
        "source": "/blueprint_catalog/topics"
      }
    },
    "catalogVisibility": {
      "type": "string",
      "description": "The configured generated-documentation prominence of this discoverable module.",
      "x-officina-config": {
        "operation": "values-to-enum",
        "source": "/blueprint_catalog/visibility"
      }
    },
    "activationSource": {
      "type": "string",
      "description": "A configured mechanism that can actually initiate this module, not a merely possible caller.",
      "x-officina-config": {
        "operation": "values-to-enum",
        "source": "/blueprint_catalog/activated_by"
      }
    },
    "catalog": {
      "type": "object",
      "required": [
        "domain",
        "topics",
        "visibility"
      ],
      "additionalProperties": false,
      "properties": {
        "domain": {
          "$ref": "#/definitions/catalogDomain"
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/catalogTopic"
          }
        },
        "visibility": {
          "$ref": "#/definitions/catalogVisibility"
        }
      }
    },
    "suggestedPermissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bash": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "command",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "args_prefix": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "network": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "web_search",
                  "web_fetch"
                ]
              },
              "domains": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "discovery": {
      "type": "object",
      "required": [
        "mechanism",
        "catalog",
        "activated_by",
        "persistent_modifier"
      ],
      "additionalProperties": false,
      "properties": {
        "mechanism": {
          "const": "skill",
          "description": "The host discovery convention used to find this module."
        },
        "catalog": {
          "$ref": "#/definitions/catalog"
        },
        "activated_by": {
          "type": "array",
          "description": "Every supported class of initiator that can directly activate this skill.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/activationSource"
          }
        },
        "persistent_modifier": {
          "type": "boolean",
          "description": "Whether invocation intentionally changes assistant behavior beyond the activating invocation; true requires the reasoning-control topic."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "persistent_modifier": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "catalog": {
                "properties": {
                  "topics": {
                    "contains": {
                      "const": "reasoning-control"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "x-famulus": {
    "gateway_policy": "whole-file",
    "export_version": "derived-from-source-interface"
  }
}
