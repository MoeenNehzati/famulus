{
  "name": "famulus",
  "description": "Personal productivity skills \u2014 daily planning, calendar, lists, writing, and math tooling",
  "author": {
    "name": "Moeen Nehzati"
  },
  "repository": "https://github.com/MoeenNehzati/famulus",
  "version": "0.0.0",
  "mcpServers": {
    "famulus": {
      "command": "python",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp_server.py"],
      "env": {
        "FAMULUS_HOST": "claude",
        "FAMULUS_PLUGIN_DATA": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
