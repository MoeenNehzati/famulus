#!/bin/sh
set -eu

tool_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
checkout=$(CDPATH= cd -- "$tool_dir/.." && pwd -P)
code_executable=$(command -v code 2>/dev/null || true)
if [ -z "$code_executable" ]; then
    echo "dev-code: code executable not found on the host PATH" >&2
    exit 2
fi
exec python "$checkout/skills/dev-activation/_rtx/_development_activation.py" exec --checkout "$checkout" -- "$code_executable" "$checkout" "$@"
